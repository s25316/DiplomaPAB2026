@page "/projects"
@inject IBackendHttpClientFactory ClientFactory
@using Diploma.Models.Projects
@using Diploma.Models.Shared
@using RADON.Models.Dictionaries.Responses
@using RADON.Models.Institutions.Responses

<div class="container py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-kanban me-2"></i> Projekty publiczne</h5>
        </div>
        <div class="card-body bg-light">

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                    <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                </div>
            }

            <!-- Pasek filtrów -->
            <div class="card bg-white border-0 shadow-sm p-3 mb-3">
                <div class="row g-3">

                    <!-- Filtrowanie po wielu Dyscyplinach -->
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-secondary">
                            <i class="bi bi-book me-1"></i> Dyscypliny:
                        </label>
                        @if (_isLoadingDisciplines)
                        {
                            <div class="d-flex align-items-center py-1">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="small text-muted">Ładowanie słownika dyscyplin...</span>
                            </div>
                        }
                        else
                        {
                            <div class="border rounded p-2 bg-light" style="max-height: 140px; overflow-y: auto;">
                                @if (_availableDisciplines.Any())
                                {
                                    @foreach (var disc in _availableDisciplines)
                                    {
                                        var isChecked = _selectedDisciplineCodes.Contains(disc.Code);
                                        <div class="form-check form-check-sm mb-1">
                                            <input class="form-check-input" type="checkbox" id="disc_@disc.Code"
                                                   checked="@isChecked"
                                                   @onchange="(e) => OnDisciplineCheckboxChanged(disc.Code, e.Value)" />
                                            <label class="form-check-label small" for="disc_@disc.Code">
                                                @disc.Name <span class="text-muted">(@disc.Code)</span>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="small text-muted fst-italic">Brak dostępnych dyscyplin.</span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Filtrowanie po wielu Instytucjach (z RadonInstitutionsComponent) -->
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold text-secondary mb-0">
                                <i class="bi bi-building me-1"></i> Instytucje edukacyjne:
                            </label>
                            <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;" @onclick="ToggleAddInstitutionFilter">
                                <i class="bi bi-plus-lg me-1"></i>@(_isAddingInstitutionFilter ? "Zamknij" : "Wybierz instytucję")
                            </button>
                        </div>

                        <!-- Panel wyboru instytucji -->
                        @if (_isAddingInstitutionFilter)
                        {
                            <div class="card card-body bg-white p-2 mb-2 shadow-sm border">
                                <span class="small text-muted mb-2">Wyszukaj i wybierz uczelnię z bazy RADON:</span>
                                <RadonInstitutionsComponent OnInstitutionSelected="HandleInstitutionFilterSelected" />
                            </div>
                        }

                        <!-- Wybrane instytucje (Tagi) -->
                        <div class="border rounded p-2 bg-light d-flex flex-wrap gap-1 align-items-center" style="min-height: 50px; max-height: 100px; overflow-y: auto;">
                            @if (_selectedInstitutionIds.Any())
                            {
                                @foreach (var instId in _selectedInstitutionIds)
                                {
                                    var name = _institutionNames.TryGetValue(instId, out var n) ? n : instId.ToString().Substring(0, 8) + "...";
                                    <span class="badge bg-white text-dark border d-inline-flex align-items-center gap-1 py-1 px-2" style="font-size: 0.75rem;">
                                        <i class="bi bi-building text-primary"></i> @name
                                        <button type="button" class="btn-close" style="font-size: 0.45rem;" aria-label="Usuń" @onclick="() => RemoveInstitutionFilter(instId)"></button>
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">Brak wybranych instytucji (filtrowanie po wszystkich).</span>
                            }
                        </div>
                    </div>

                </div>

                <!-- Przyciski akcji filtrów -->
                <div class="row mt-3">
                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button class="btn btn-primary btn-sm px-4" @onclick="ApplyFilters">
                            <i class="bi bi-search me-1"></i> Filtruj
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Resetuj filtry
                        </button>
                    </div>
                </div>
            </div>

            <!-- Pasek narzędzi: Sortowanie i Liczba elementów -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6 d-flex gap-2 align-items-center">
                    <label class="form-label mb-0 text-nowrap">Sortuj:</label>
                    <select class="form-select form-select-sm" @value="_selectedOrderBy" @onchange="OnOrderByChanged">
                        <option value="1">Tytuł</option>
                        <option value="2">Data utworzenia</option>
                    </select>
                    <select class="form-select form-select-sm" @value="_selectedOrder" @onchange="OnOrderChanged">
                        <option value="1">Rosnąco</option>
                        <option value="2">Malejąco</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0 gap-2">
                    <label class="form-label mb-0 text-nowrap">Na stronie:</label>
                    <select class="form-select form-select-sm w-auto" @value="_itemsPerPage" @onchange="OnItemsPerPageChanged">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Ładowanie projektów...</p>
                </div>
            }
            else if (_projects == null || !_projects.Any())
            {
                <div class="text-center text-muted py-4">
                    <p class="mb-0">Brak publicznych projektów spełniających kryteria.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var project in _projects)
                    {
                        <div class="col-12">
                            <PublicProjectCardComponent Project="project"
                                                        IsSelected="(_selectedProjectId == project.ProjectId)"
                                                        OnToggleDetails="ToggleDetails"
                                                        OnCloseDetails="CloseDetails" />
                        </div>
                    }
                </div>

                <!-- Paginacja -->
                @if (_totalPages > 1)
                {
                    <nav class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted small">Strona @_currentPage z @_totalPages (Łącznie: @_totalCount)</span>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Poprzednia</button>
                            </li>
                            @for (int i = 1; i <= _totalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                                </li>
                            }
                            <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Następna</button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<ProjectDto> _projects = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private Guid? _selectedProjectId = null;

    // --- Filtry: Dyscypliny ---
    private List<DictionaryItem> _availableDisciplines = new();
    private bool _isLoadingDisciplines = false;
    private HashSet<string> _selectedDisciplineCodes = new();

    // --- Filtry: Instytucje ---
    private bool _isAddingInstitutionFilter = false;
    private HashSet<Guid> _selectedInstitutionIds = new();
    private Dictionary<Guid, string> _institutionNames = new();

    // --- Parametry paginacji i sortowania ---
    private int _selectedOrderBy = 2;
    private int _selectedOrder = 2;
    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int _totalCount = 0;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableDisciplinesAsync();
        await LoadProjectsAsync();
    }

    private async Task LoadAvailableDisciplinesAsync()
    {
        _isLoadingDisciplines = true;
        try
        {
            var client = await ClientFactory.CreateClientAsync();
            var response = await client.GetAsync("api/radon/shared/disciplines");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<DictionaryItem>>();
                if (result != null)
                {
                    _availableDisciplines = result;
                }
            }
        }
        catch
        {
            // Ignoruj błąd ładowania słownika w tle
        }
        finally
        {
            _isLoadingDisciplines = false;
        }
    }

    private void ToggleDetails(Guid projectId)
    {
        if (_selectedProjectId == projectId)
        {
            CloseDetails();
        }
        else
        {
            _selectedProjectId = projectId;
        }
    }

    private void CloseDetails()
    {
        _selectedProjectId = null;
    }

    private void OnDisciplineCheckboxChanged(string code, object? value)
    {
        if (value is bool isChecked && isChecked)
        {
            _selectedDisciplineCodes.Add(code);
        }
        else
        {
            _selectedDisciplineCodes.Remove(code);
        }
    }

    private void ToggleAddInstitutionFilter()
    {
        _isAddingInstitutionFilter = !_isAddingInstitutionFilter;
    }

    private void HandleInstitutionFilterSelected(Institution institution)
    {
        var id = institution.InstitutionUuid;
        var name = institution.Names?.OrderByDescending(n => n.Date).FirstOrDefault()?.Name ?? id.ToString();

        if (_selectedInstitutionIds.Add(id))
        {
            _institutionNames[id] = name;
        }

        _isAddingInstitutionFilter = false;
    }

    private void RemoveInstitutionFilter(Guid id)
    {
        _selectedInstitutionIds.Remove(id);
        _institutionNames.Remove(id);
    }

    private async Task LoadProjectsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var queryParams = new List<string>
            {
                $"OrderBy={_selectedOrderBy}",
                $"Order={_selectedOrder}",
                $"Pagination.Page={_currentPage}",
                $"Pagination.ItemsPerPage={_itemsPerPage}"
            };

            // Dodawanie wielu dyscyplin
            foreach (var code in _selectedDisciplineCodes)
            {
                queryParams.Add($"Disciplines={Uri.EscapeDataString(code)}");
            }

            // Dodawanie wielu instytucji
            foreach (var instId in _selectedInstitutionIds)
            {
                queryParams.Add($"Institutions={instId}");
            }

            var url = $"api/projects/all?{string.Join("&", queryParams)}";
            var client = await ClientFactory.CreateClientAsync();
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Response<ProjectDto>>();
                if (result != null)
                {
                    _projects = result.Items?.ToList() ?? new();
                    _totalCount = result.Pagination.TotalCount;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / _itemsPerPage);
                    if (_totalPages == 0) _totalPages = 1;
                }
            }
            else
            {
                _errorMessage = "Nie udało się pobrać listy projektów.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadProjectsAsync();
    }

    private async Task ResetFilters()
    {
        _selectedDisciplineCodes.Clear();
        _selectedInstitutionIds.Clear();
        _institutionNames.Clear();
        _isAddingInstitutionFilter = false;
        _currentPage = 1;
        await LoadProjectsAsync();
    }

    private async Task OnOrderByChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrderBy = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task OnOrderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrder = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task OnItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _itemsPerPage = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadProjectsAsync();
    }
}