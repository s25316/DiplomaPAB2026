@inject IBackendHttpClientFactory ClientFactory

@using Diploma.Models.Projects
@using Diploma.Models.Shared
@using RADON.Models.Dictionaries.Responses
@using RADON.Models.Institutions.Responses

<div class="container py-4">
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-kanban me-2"></i> Projekty publiczne</h5>
            <button class="btn btn-outline-light btn-sm" @onclick="ToggleFilterPanel">
                <i class="bi bi-funnel me-1"></i> @(_showFilters ? "Ukryj filtry" : "Pokaż filtry")
            </button>
        </div>

        <div class="card-body bg-light">

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                    <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                </div>
            }

            <!-- Rozwijany / Pionowy panel filtrów -->
            @if (_showFilters)
            {
                <div class="card bg-white border shadow-sm p-3 mb-4">
                    <div class="row g-3">

                        <!-- Status rekrutacji (3 stany: Wszystkie, Aktywne, Nieaktywne) -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary mb-1">
                                <i class="bi bi-person-check me-1"></i> Status rekrutacji:
                            </label>
                            <select class="form-select form-select-sm" @value="_selectedIsRecruitmentActive" @onchange="OnRecruitmentActiveChanged">
                                <option value="">Wszystkie projekty</option>
                                <option value="true">Tylko z aktywną rekrutacją</option>
                                <option value="false">Tylko z nieaktywną rekrutacją</option>
                            </select>
                        </div>

                        <!-- Puste miejsce w rzędzie dla zachowania układu siatki (opcjonalnie) -->
                        <div class="col-md-6"></div>

                        <!-- Dyscypliny (Multiselect z wyszukiwarką) -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-secondary mb-1">
                                <i class="bi bi-book me-1"></i> Dyscypliny naukowe:
                            </label>
                            @if (_isLoadingDisciplines)
                            {
                                <div class="d-flex align-items-center py-2">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="small text-muted">Ładowanie słownika dyscyplin...</span>
                                </div>
                            }
                            else
                            {
                                <div class="dropdown">
                                    <!-- Pole wybranej listy tagów -->
                                    <div class="form-control d-flex flex-wrap gap-1 align-items-center bg-white" style="min-height: 38px; cursor: text;" @onclick="FocusDisciplineSearch" @onclick:stopPropagation="true">

                                        @if (_selectedDisciplineCodes.Any())
                                        {
                                            @foreach (var code in _selectedDisciplineCodes)
                                            {
                                                var discName = _availableDisciplines.FirstOrDefault(d => d.Code == code)?.Name ?? code;
                                                <span class="badge bg-primary text-white d-inline-flex align-items-center gap-1 py-1 px-2" style="font-size: 0.75rem;">
                                                    @discName
                                                    <button type="button" class="btn-close btn-close-white" style="font-size: 0.5rem;" aria-label="Usuń" @onclick="() => RemoveDisciplineFilter(code)" @onclick:stopPropagation="true"></button>
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Wszystkie dyscypliny...</span>
                                        }

                                        <input type="text"
                                               class="border-0 flex-grow-1 p-0 ms-1"
                                               style="outline: none; background: transparent; font-size: 0.85rem; min-width: 120px;"
                                               placeholder="@(_selectedDisciplineCodes.Any() ? "Szukaj kolejnej..." : "")"
                                               @bind="_disciplineSearchQuery"
                                               @bind:event="oninput"
                                               @onfocus="() => _isDisciplineDropdownOpen = true" />
                                    </div>

                                    <!-- Rozwijane menu z opcjami -->
                                    @if (_isDisciplineDropdownOpen)
                                    {
                                        <!-- Przezroczyste tło do wykrywania kliknięcia na zewnątrz -->
                                        <div class="position-fixed w-100 h-100 top-0 start-0" style="z-index: 1050; background: transparent;" @onclick="() => _isDisciplineDropdownOpen = false"></div>

                                        <div class="dropdown-menu show w-100 shadow-sm p-1" style="z-index: 1051; max-height: 180px; overflow-y: auto;" @onclick:stopPropagation="true">
                                            @{
                                                var filteredDisciplines = _availableDisciplines
                                                    .Where(d => string.IsNullOrWhiteSpace(_disciplineSearchQuery) ||
                                                                d.Name.Contains(_disciplineSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                                                d.Code.Contains(_disciplineSearchQuery, StringComparison.OrdinalIgnoreCase))
                                                    .ToList();
                                            }

                                            @if (filteredDisciplines.Any())
                                            {
                                                @foreach (var disc in filteredDisciplines)
                                                {
                                                    var isSelected = _selectedDisciplineCodes.Contains(disc.Code);
                                                    <div class="dropdown-item d-flex justify-content-between align-items-center py-1 px-2 rounded @(isSelected ? "bg-light fw-bold text-primary" : "")"
                                                         style="cursor: pointer; font-size: 0.85rem;"
                                                         @onclick="() => ToggleDisciplineSelection(disc.Code)">
                                                        <span>@disc.Name <span class="text-muted small">(@disc.Code)</span></span>
                                                        @if (isSelected)
                                                        {
                                                            <i class="bi bi-check2 text-primary"></i>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="dropdown-item-text text-muted small py-1">Brak pasujących dyscyplin</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Instytucje edukacyjne -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold text-secondary mb-0">
                                    <i class="bi bi-building me-1"></i> Instytucje edukacyjne:
                                </label>
                                <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;" @onclick="ToggleAddInstitutionFilter">
                                    <i class="bi bi-plus-lg me-1"></i>@(_isAddingInstitutionFilter ? "Zamknij wyszukiwarkę" : "Wybierz z bazy RADON")
                                </button>
                            </div>

                            @if (_isAddingInstitutionFilter)
                            {
                                <div class="card card-body bg-white p-2 mb-2 shadow-sm border">
                                    <RadonInstitutionsComponent OnInstitutionSelected="HandleInstitutionFilterSelected" />
                                </div>
                            }

                            <div class="border rounded p-2 bg-light d-flex flex-wrap gap-1 align-items-center" style="min-height: 70px; max-height: 130px; overflow-y: auto;">
                                @if (_selectedInstitutionIds.Any())
                                {
                                    @foreach (var instId in _selectedInstitutionIds)
                                    {
                                        var name = _institutionNames.TryGetValue(instId, out var n) ? n : instId.ToString().Substring(0, 8) + "...";
                                        <span class="badge bg-white text-dark border d-inline-flex align-items-center gap-1 py-1.5 px-2 shadow-sm" style="font-size: 0.75rem;">
                                            <i class="bi bi-building text-primary"></i> @name
                                            <button type="button" class="btn-close" style="font-size: 0.5rem;" aria-label="Usuń" @onclick="() => RemoveInstitutionFilter(instId)"></button>
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic w-100 text-center py-2">Brak wybranych instytucji (filtrowanie po wszystkich).</span>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- Pasek akcji filtrów -->
                    <div class="row mt-3 pt-3 border-top g-2 align-items-center">
                        <div class="col-sm-6 text-muted small">
                            <span>Wybrane filtry: <strong>@(_selectedDisciplineCodes.Count)</strong> dyscyplin, <strong>@(_selectedInstitutionIds.Count)</strong> instytucji</span>
                        </div>
                        <div class="col-sm-6 d-flex justify-content-sm-end gap-2">
                            <button class="btn btn-outline-secondary btn-sm px-3" @onclick="ResetFilters">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Resetuj
                            </button>
                            <button class="btn btn-primary btn-sm px-4" @onclick="ApplyFilters">
                                <i class="bi bi-search me-1"></i> Zastosuj filtry
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Pasek narzędzi: Sortowanie i Liczba elementów -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3 mb-3 bg-white p-3 rounded shadow-sm">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-secondary small fw-bold text-nowrap"><i class="bi bi-sort-down me-1"></i>Sortuj:</span>
                    <select class="form-select form-select-sm w-auto" @value="_selectedOrderBy" @onchange="OnOrderByChanged">
                        <option value="1">Tytuł</option>
                        <option value="2">Data utworzenia</option>
                    </select>
                    <select class="form-select form-select-sm w-auto" @value="_selectedOrder" @onchange="OnOrderChanged">
                        <option value="1">Rosnąco</option>
                        <option value="2">Malejąco</option>
                    </select>
                </div>

                <div class="d-flex gap-2 align-items-center justify-content-md-end">
                    <span class="text-secondary small fw-bold text-nowrap">Na stronie:</span>
                    <select class="form-select form-select-sm w-auto" @value="_itemsPerPage" @onchange="OnItemsPerPageChanged">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            <!-- Lista projektów -->
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Ładowanie projektów...</p>
                </div>
            }
            else if (_projects == null || !_projects.Any())
            {
                <div class="text-center text-muted py-5 bg-white rounded shadow-sm">
                    <i class="bi bi-inbox fs-1 text-secondary"></i>
                    <p class="mb-0 mt-2">Brak publicznych projektów spełniających kryteria.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var project in _projects)
                    {
                        <div class="col-12">
                            <PublicProjectCardComponent Project="project"
                                                        IsSelected="(_selectedProjectId == project.ProjectId)"
                                                        OnToggleDetails="ToggleDetails"
                                                        OnCloseDetails="CloseDetails" />
                        </div>
                    }
                </div>

                <!-- Paginacja -->
                @if (_totalPages > 1)
                {
                    <nav class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-2">
                        <span class="text-muted small">Strona @_currentPage z @_totalPages (Łącznie: @_totalCount projektów)</span>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Poprzednia</button>
                            </li>
                            @for (int i = 1; i <= _totalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                                </li>
                            }
                            <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Następna</button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<ProjectLocalDto> _projects = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private Guid? _selectedProjectId = null;
    private bool _showFilters = true;

    // --- Filtry: Status rekrutacji (null, true, false) ---
    private bool? _selectedIsRecruitmentActive = null;

    // --- Filtry: Dyscypliny ---
    private List<DictionaryItem> _availableDisciplines = new();
    private bool _isLoadingDisciplines = false;
    private HashSet<string> _selectedDisciplineCodes = new();
    private string _disciplineSearchQuery = string.Empty;
    private bool _isDisciplineDropdownOpen = false;

    // --- Filtry: Instytucje ---
    private bool _isAddingInstitutionFilter = false;
    private HashSet<Guid> _selectedInstitutionIds = new();
    private Dictionary<Guid, string> _institutionNames = new();

    // --- Parametry paginacji i sortowania ---
    private int _selectedOrderBy = 2;
    private int _selectedOrder = 2;
    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int _totalCount = 0;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableDisciplinesAsync();
        await LoadProjectsAsync();
    }

    private void ToggleFilterPanel()
    {
        _showFilters = !_showFilters;
    }

    private async Task LoadAvailableDisciplinesAsync()
    {
        _isLoadingDisciplines = true;
        try
        {
            var client = await ClientFactory.CreateClientAsync();
            var response = await client.GetAsync("api/radon/shared/disciplines");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<DictionaryItem>>();
                if (result != null)
                {
                    _availableDisciplines = result;
                }
            }
        }
        catch
        {
            // Ignoruj błąd ładowania słownika
        }
        finally
        {
            _isLoadingDisciplines = false;
        }
    }

    private void ToggleDetails(Guid projectId)
    {
        if (_selectedProjectId == projectId)
        {
            CloseDetails();
        }
        else
        {
            _selectedProjectId = projectId;
        }
    }

    private void CloseDetails()
    {
        _selectedProjectId = null;
    }

    private void FocusDisciplineSearch()
    {
        _isDisciplineDropdownOpen = true;
    }

    private void ToggleDisciplineSelection(string code)
    {
        if (_selectedDisciplineCodes.Contains(code))
        {
            _selectedDisciplineCodes.Remove(code);
        }
        else
        {
            _selectedDisciplineCodes.Add(code);
        }
    }

    private void RemoveDisciplineFilter(string code)
    {
        _selectedDisciplineCodes.Remove(code);
    }

    private void ToggleAddInstitutionFilter()
    {
        _isAddingInstitutionFilter = !_isAddingInstitutionFilter;
    }

    private void HandleInstitutionFilterSelected(Institution institution)
    {
        var id = institution.InstitutionUuid;
        var name = institution.Names?.OrderByDescending(n => n.Date).FirstOrDefault()?.Name ?? id.ToString();

        if (_selectedInstitutionIds.Add(id))
        {
            _institutionNames[id] = name;
        }

        _isAddingInstitutionFilter = false;
    }

    private void RemoveInstitutionFilter(Guid id)
    {
        _selectedInstitutionIds.Remove(id);
        _institutionNames.Remove(id);
    }

    private async Task LoadProjectsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var queryParams = new List<string>
            {
                $"OrderBy={_selectedOrderBy}",
                $"Order={_selectedOrder}",
                $"Pagination.Page={_currentPage}",
                $"Pagination.ItemsPerPage={_itemsPerPage}"
            };

            // Dodaj IsRecruitmentActive tylko jeśli ma wartość (true lub false).
            // Jeśli jest null, pomijamy parametr lub przekazujemy w zależności od wymagania API.
            if (_selectedIsRecruitmentActive.HasValue)
            {
                queryParams.Add($"IsRecruitmentActive={_selectedIsRecruitmentActive.Value.ToString().ToLower()}");
            }

            foreach (var code in _selectedDisciplineCodes)
            {
                queryParams.Add($"Disciplines={Uri.EscapeDataString(code)}");
            }

            foreach (var instId in _selectedInstitutionIds)
            {
                queryParams.Add($"Institutions={instId}");
            }

            var url = $"api/projects/all?{string.Join("&", queryParams)}";
            var client = await ClientFactory.CreateClientAsync();
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Response<ProjectLocalDto>>();
                if (result != null)
                {
                    _projects = result.Items?.ToList() ?? new();
                    _totalCount = result.Pagination.TotalCount;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / _itemsPerPage);
                    if (_totalPages == 0) _totalPages = 1;
                }
            }
            else
            {
                _errorMessage = "Nie udało się pobrać listy projektów.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadProjectsAsync();
    }

    private async Task ResetFilters()
    {
        _selectedIsRecruitmentActive = null;
        _selectedDisciplineCodes.Clear();
        _disciplineSearchQuery = string.Empty;
        _selectedInstitutionIds.Clear();
        _institutionNames.Clear();
        _isAddingInstitutionFilter = false;
        _currentPage = 1;
        await LoadProjectsAsync();
    }

    private void OnRecruitmentActiveChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val))
        {
            _selectedIsRecruitmentActive = null;
        }
        else if (bool.TryParse(val, out var parsed))
        {
            _selectedIsRecruitmentActive = parsed;
        }
    }

    private async Task OnOrderByChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrderBy = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task OnOrderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrder = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task OnItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _itemsPerPage = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadProjectsAsync();
    }
}