@using Frontend.Components.Authentications.Layout

<header class="navbar navbar-dark bg-dark px-4 w-100 mb-4 custom-top-menu">
    <div class="container-fluid d-flex justify-content-between align-items-center">

        <!-- Lewa strona -->
        <div class="d-flex align-items-center gap-3">
            <NavLink class="navbar-brand text-light m-0" href="" Match="NavLinkMatch.All">
                Main
            </NavLink>
        </div>

        <!-- Prawa strona -->
        <div class="navbar-nav d-flex flex-row align-items-center gap-3">

            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2">
                        <NavLink class="btn btn-outline-light btn-sm px-3" href="profile/projects" Match="NavLinkMatch.All">
                            Moje projekty
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2">
                        <NavLink class="btn btn-outline-light btn-sm px-3" href="profile" Match="NavLinkMatch.All">
                            Mój Profil
                        </NavLink>

                        <LogOutComponent />
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-link btn btn-outline-light btn-sm px-3 text-dark bg-light" href="authentication">Zaloguj się</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

    </div>
</header>