@page "/profile/recruitments"
@inject IJSRuntime JSRuntime
@using Diploma.Models.Recruitments
@using Diploma.Models.Shared

<AuthorizeView>
    <Authorized>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i> Moje rekrutacje</h5>
            </div>
            <div class="card-body bg-light">

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                    </div>
                }

                <!-- Pasek narzędzi: Status, Sortowanie i Liczba elementów na stronie -->
                <div class="row mb-3 align-items-center">
                    <div class="col-md-7 d-flex flex-wrap gap-2 align-items-center">
                        <label class="form-label mb-0 text-nowrap">Status:</label>
                        <select class="form-select form-select-sm w-auto" @value="_selectedStatusId" @onchange="OnStatusChanged">
                            <option value="0">Wszystkie</option>
                            <option value="1">Oczekujące</option>
                            <option value="2">Zaakceptowane</option>
                            <option value="3">Odrzucone</option>
                        </select>

                        <label class="form-label mb-0 text-nowrap ms-2">Sortuj:</label>
                        <select class="form-select form-select-sm w-auto" @value="_selectedOrderBy" @onchange="OnOrderByChanged">
                            <option value="2">Data utworzenia</option>
                        </select>
                        <select class="form-select form-select-sm w-auto" @value="_selectedOrder" @onchange="OnOrderChanged">
                            <option value="1">Rosnąco</option>
                            <option value="2">Malejąco</option>
                        </select>
                    </div>
                    <div class="col-md-5 d-flex justify-content-md-end align-items-center mt-2 mt-md-0 gap-2">
                        <label class="form-label mb-0 text-nowrap">Na stronie:</label>
                        <select class="form-select form-select-sm w-auto" @value="_itemsPerPage" @onchange="OnItemsPerPageChanged">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>

                @if (_isLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Ładowanie Twoich rekrutacji...</p>
                    </div>
                }
                else if (_recruitments == null || !_recruitments.Any())
                {
                    <div class="text-center text-muted py-4">
                        <p class="mb-0">Brak zgłoszeń rekrutacyjnych spełniających kryteria.</p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var recruitment in _recruitments)
                        {
                            var isExpanded = _expandedRecruitmentIds.Contains(recruitment.RecruitmentId);
                            <div class="col-12">
                                <div class="card shadow-sm border-0">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <!-- Informacje o projekcie w rekrutacji -->
                                            <div class="col-md-8">
                                                <h5 class="text-dark mb-1">
                                                    <i class="bi bi-folder2-open me-1 text-secondary"></i>
                                                    <strong>@(recruitment.Project?.Title ?? "Projekt usunięty lub niedostępny")</strong>
                                                </h5>
                                                <p class="text-muted small mb-2 text-truncate">
                                                    @(recruitment.Project?.Description ?? "Brak opisu.")
                                                </p>
                                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                                    <span class="badge bg-info text-dark">
                                                        Status: @recruitment.Status.Name
                                                    </span>
                                                    <span class="text-muted small">
                                                        <i class="bi bi-calendar3 me-1"></i> Utworzono: @recruitment.Project?.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Akcja rozwijania szczegółów ról -->
                                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => ToggleDetails(recruitment.RecruitmentId)">
                                                    <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                                    @(isExpanded ? "Ukryj szczegóły" : "Zobacz szczegóły ról")
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Rozwijana sekcja z wybranymi rolami -->
                                        @if (isExpanded)
                                        {
                                            <hr class="my-3 text-muted" />
                                            <div class="bg-light p-3 rounded border">
                                                <h6 class="text-primary fw-bold mb-2 small text-uppercase">Wybrane role w tym zgłoszeniu:</h6>

                                                @if (recruitment.ProjectRoles != null && recruitment.ProjectRoles.Any())
                                                {
                                                    <div class="list-group">
                                                        @foreach (var role in recruitment.ProjectRoles)
                                                        {
                                                            <div class="list-group-item bg-white p-2 mb-2 border rounded shadow-sm">
                                                                <div class="fw-bold text-dark small"><i class="bi bi-person-badge me-1 text-secondary"></i> @role.Title</div>
                                                                <div class="text-muted small mb-1">@role.Description</div>

                                                                @if (role.Disciplines != null && role.Disciplines.Any())
                                                                {
                                                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                                                        @foreach (var disc in role.Disciplines)
                                                                        {
                                                                            <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">
                                                                                @disc.Discipline.Name
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small fst-italic">Brak powiązanych ról dla tego zgłoszenia.</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Paginacja -->
                    @if (_totalPages > 1)
                    {
                        <nav class="d-flex justify-content-between align-items-center mt-3">
                            <span class="text-muted small">Strona @_currentPage z @_totalPages (Łącznie: @_totalCount)</span>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Poprzednia</button>
                                </li>
                                @for (int i = 1; i <= _totalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                                    </li>
                                }
                                <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Następna</button>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-5 text-center alert alert-warning">
            <h4>Musisz się zalogować, aby uzyskać dostęp do profilu.</h4>
            <a href="/authentication" class="btn btn-primary mt-3">Zaloguj się</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private IBackendHttpClientFactory ClientFactory { get; set; } = default!;

    private List<RecruitmentDto> _recruitments = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private int _selectedStatusId = 0;
    private int _selectedOrderBy = 2;
    private int _selectedOrder = 2;
    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int _totalCount = 0;
    private int _totalPages = 1;

    private HashSet<Guid> _expandedRecruitmentIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRecruitmentsAsync();
    }

    private async Task LoadRecruitmentsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var url = $"api/recruitments?OrderBy={_selectedOrderBy}&Order={_selectedOrder}&Pagination.Page={_currentPage}&Pagination.ItemsPerPage={_itemsPerPage}";

            if (_selectedStatusId > 0)
            {
                url += $"&StatusId={_selectedStatusId}";
            }

            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Response<RecruitmentDto>>();
                if (result != null)
                {
                    _recruitments = result.Items?.ToList() ?? new();
                    _totalCount = result.Pagination.TotalCount;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / _itemsPerPage);
                    if (_totalPages == 0) _totalPages = 1;
                }
            }
            else
            {
                _errorMessage = "Nie udało się pobrać listy rekrutacji.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleDetails(Guid recruitmentId)
    {
        if (_expandedRecruitmentIds.Contains(recruitmentId))
        {
            _expandedRecruitmentIds.Remove(recruitmentId);
        }
        else
        {
            _expandedRecruitmentIds.Add(recruitmentId);
        }
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedStatusId = parsed;
            _currentPage = 1;
            await LoadRecruitmentsAsync();
        }
    }

    private async Task OnOrderByChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrderBy = parsed;
            _currentPage = 1;
            await LoadRecruitmentsAsync();
        }
    }

    private async Task OnOrderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrder = parsed;
            _currentPage = 1;
            await LoadRecruitmentsAsync();
        }
    }

    private async Task OnItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _itemsPerPage = parsed;
            _currentPage = 1;
            await LoadRecruitmentsAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadRecruitmentsAsync();
    }
}