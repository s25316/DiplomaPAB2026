@using Diploma.Models.PersonEmployments
@using Diploma.Models.Shared
@using Base.Models.ValueObjects.Regony
@using static GUS.REGON.Models.Responses.Report
@inject IBackendHttpClientFactory HttpClientFactory
@inject IRegonService RegonService

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i>Historia Zatrudnienia</h5>
        <button class="btn btn-light btn-sm" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg me-1"></i> Dodaj zatrudnienie
        </button>
    </div>
    <div class="card-body">

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- Pasek narzędzi: Sortowanie i Liczba elementów na stronie -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-6 d-flex gap-2 align-items-center">
                <label class="form-label mb-0 text-nowrap">Sortuj:</label>
                <select class="form-select form-select-sm" @value="_selectedOrderBy" @onchange="OnOrderByChanged">
                    <option value="@PersonEmploymentQueryParameters.PersonEmploymentOrderBy.From">Data rozpoczęcia</option>
                    <option value="@PersonEmploymentQueryParameters.PersonEmploymentOrderBy.Position">Stanowisko</option>
                </select>
                <select class="form-select form-select-sm" @value="_selectedOrder" @onchange="OnOrderChanged">
                    <option value="@Order.Ascending">Rosnąco</option>
                    <option value="@Order.Descending">Malejąco</option>
                </select>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0 gap-2">
                <label class="form-label mb-0 text-nowrap">Na stronie:</label>
                <select class="form-select form-select-sm w-auto" @value="_itemsPerPage" @onchange="OnItemsPerPageChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Ładowanie historii zatrudnienia...</p>
            </div>
        }
        else if (_employments == null || !_employments.Any())
        {
            <div class="text-center text-muted py-4">
                <p class="mb-0">Brak dodanych wpisów o zatrudnieniu.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Stanowisko</th>
                            <th>Firma (REGON)</th>
                            <th>Opis</th>
                            <th>Okres zatrudnienia</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employment in _employments)
                        {
                            <tr>
                                <td><strong>@employment.Position</strong></td>
                                <td><code>@employment.Regon</code></td>
                                <td><span class="text-truncate d-inline-block" style="max-width: 250px;">@employment.Description</span></td>
                                <td>
                                    @employment.From.ToString("dd.MM.yyyy") -
                                    @(employment.To.HasValue ? employment.To.Value.ToString("dd.MM.yyyy") : "Obecnie")
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => OpenEditModal(employment)">
                                        <i class="bi bi-pencil"> Edytuj</i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteEmploymentAsync(employment.EmploymentId)">
                                        <i class="bi bi-trash"> Usuń</i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginacja -->
            @if (_totalPages > 1)
            {
                <nav class="d-flex justify-content-between align-items-center mt-3">
                    <span class="text-muted small">Strona @_currentPage z @_totalPages (Łącznie: @_totalCount)</span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Poprzednia</button>
                        </li>
                        @for (int i = 1; i <= _totalPages; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Następna</button>
                        </li>
                    </ul>
                </nav>
            }
        }

    </div>
</div>

<!-- MODAL DODAWANIA / EDYCJI -->
@if (_isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_isEditing ? "Edytuj zatrudnienie" : "Dodaj zatrudnienie")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <EditForm Model="_currentModel" OnValidSubmit="SaveEmploymentAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">

                        <!-- TUTAJ DODANY KOMUNIKAT BŁĘDU W MODALU -->
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                            </div>
                        }

                        <ValidationSummary class="text-danger mb-3" />
                        <!-- SEKCJA REGON: Inna dla Dodawania (wyszukiwarka), inna dla Edycji (zablokowane pole) -->
                        @if (!_isEditing)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold">Wyszukaj pracodawcę po numerze REGON:</label>

                                <!-- Wbudowany komponent wyszukiwania REGON -->
                                <div class="card shadow-sm border">
                                    <div class="card-body">
                                        <div class="input-group mb-3">
                                            <input type="text" class="form-control" @bind="_regonSearchInput" placeholder="Wprowadź numer REGON..." />
                                            <button class="btn btn-outline-primary" type="button" @onclick="SearchInstitutionAsync" disabled="@_isSearchingRegon">
                                                @if (_isSearchingRegon)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                }
                                                <i class="bi bi-search me-1"></i> Szukaj w GUS
                                            </button>
                                        </div>

                                        @if (!string.IsNullOrEmpty(_regonSearchError))
                                        {
                                            <div class="alert alert-danger py-2 mb-2">@_regonSearchError</div>
                                        }

                                        @if (_searchedInstitution is not null)
                                        {
                                            <div class="mt-3">
                                                <InstitutionDetailsView Institution="_searchedInstitution" />
                                                @if (_searchedInstitution.Status == Status.Istneje)
                                                {
                                                    <div class="text-end mt-2">
                                                        <button type="button" class="btn btn-success btn-sm" @onclick="ConfirmSelectedRegon">
                                                            <i class="bi bi-check-circle me-1"></i> Wybierz tę firmę
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Numer REGON pracodawcy</label>
                                <InputText class="form-control" @bind-Value="_currentModel.Regon" disabled />
                                <div class="form-text">Zmiana numeru REGON w trybie edycji jest zablokowana.</div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Stanowisko</label>
                                <InputText class="form-control" @bind-Value="_currentModel.Position" placeholder="np. Programista C#" />
                                <ValidationMessage For="() => _currentModel.Position" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Data rozpoczęcia</label>
                                <InputDate class="form-control" @bind-Value="_currentModel.From" />
                                <ValidationMessage For="() => _currentModel.From" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Data zakończenia</label>
                                <InputDate class="form-control" @bind-Value="_currentModel.To" />
                                <ValidationMessage For="() => _currentModel.To" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Opis stanowiska / Obowiązki</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_currentModel.Description" placeholder="Opisz swoje zadania..."></InputTextArea>
                            <ValidationMessage For="() => _currentModel.Description" />
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Anuluj</button>
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Zapisz
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<PersonEmploymentDto> _employments = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _successMessage;
    private string? _errorMessage;

    // Parametry filtrowania/paginacji/sortowania
    private PersonEmploymentQueryParameters.PersonEmploymentOrderBy _selectedOrderBy = PersonEmploymentQueryParameters.PersonEmploymentOrderBy.From;
    private Order _selectedOrder = Order.Descending;
    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int _totalCount = 0;
    private int _totalPages = 1;

    // Stan modalu
    private bool _isModalOpen = false;
    private bool _isEditing = false;
    private Guid _selectedEmploymentId;
    private EmploymentFormModel _currentModel = new();

    // Stan dla wyszukiwarki REGON wewnątrz modalu
    private string _regonSearchInput = string.Empty;
    private bool _isSearchingRegon = false;
    private string? _regonSearchError;
    private Full? _searchedInstitution = null;

    public class EmploymentFormModel
    {
        [Required(ErrorMessage = "Wybór pracodawcy (REGON) jest wymagany.")]
        public string Regon { get; set; } = string.Empty;

        [Required(ErrorMessage = "Stanowisko jest wymagane.")]
        public string Position { get; set; } = string.Empty;

        [Required(ErrorMessage = "Opis jest wymagany.")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Data rozpoczęcia jest wymagana.")]
        public DateOnly From { get; set; } = DateOnly.FromDateTime(DateTime.Today);

        public DateOnly? To { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmploymentsAsync();
    }

    private async Task LoadEmploymentsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var url = $"api/person/profile/employments?OrderBy={(int)_selectedOrderBy}&Order={(int)_selectedOrder}&Pagination.Page={_currentPage}&Pagination.ItemsPerPage={_itemsPerPage}";
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Response<PersonEmploymentDto>>();
                if (result != null)
                {
                    _employments = result.Items?.ToList() ?? new();
                    _totalCount = result.Pagination.TotalCount;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / _itemsPerPage);
                    if (_totalPages == 0) _totalPages = 1;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _errorMessage = "Profil jest nieaktywny.";
            }
            else
            {
                _errorMessage = "Nie udało się pobrać historii zatrudnienia.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchInstitutionAsync()
    {
        if (string.IsNullOrWhiteSpace(_regonSearchInput))
        {
            _regonSearchError = "Wprowadź numer REGON.";
            return;
        }

        _isSearchingRegon = true;
        _regonSearchError = null;
        _searchedInstitution = null;

        try
        {
            var cleanRegon = _regonSearchInput
                .Split(new[] { ',', ' ', '\n', '\r', '-', '_' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(r => r.Trim())
                .Where(r => !string.IsNullOrEmpty(r))
                .FirstOrDefault();

            if (string.IsNullOrWhiteSpace(cleanRegon) || !Regon.TryParse(cleanRegon, out _))
            {
                _regonSearchError = "Podano niepoprawny numer REGON.";
                _isSearchingRegon = false;
                return;
            }

            var response = await RegonService.GetAsync([cleanRegon]);
            if (response is not null)
            {
                _searchedInstitution = response.FirstOrDefault();
                if (_searchedInstitution == null)
                {
                    _regonSearchError = "Nie znaleziono firmy o takim numerze REGON.";
                }
            }
            else
            {
                _regonSearchError = "Wystąpił błąd podczas pobierania danych z GUS.";
            }
        }
        catch (Exception)
        {
            _regonSearchError = "Wystąpił błąd połączenia z serwisem REGON.";
        }
        finally
        {
            _isSearchingRegon = false;
        }
    }

    private void ConfirmSelectedRegon()
    {
        if (_searchedInstitution != null && !string.IsNullOrEmpty(_searchedInstitution.Regon))
        {
            _currentModel.Regon = _searchedInstitution.Regon;
            _successMessage = $"Pomyślnie wybrano firmę: {_searchedInstitution.Institution?.Nazwa}";
        }
    }

    private async Task OnOrderByChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<PersonEmploymentQueryParameters.PersonEmploymentOrderBy>(e.Value?.ToString(), out var parsed))
        {
            _selectedOrderBy = parsed;
            _currentPage = 1;
            await LoadEmploymentsAsync();
        }
    }

    private async Task OnOrderChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Order>(e.Value?.ToString(), out var parsed))
        {
            _selectedOrder = parsed;
            _currentPage = 1;
            await LoadEmploymentsAsync();
        }
    }

    private async Task OnItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _itemsPerPage = parsed;
            _currentPage = 1;
            await LoadEmploymentsAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadEmploymentsAsync();
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _currentModel = new();
        _regonSearchInput = string.Empty;
        _searchedInstitution = null;
        _regonSearchError = null;
        _isModalOpen = true;
    }

    private void OpenEditModal(PersonEmploymentDto dto)
    {
        _isEditing = true;
        _selectedEmploymentId = dto.EmploymentId;
        _currentModel = new EmploymentFormModel
        {
            Regon = dto.Regon,
            Position = dto.Position,
            Description = dto.Description,
            From = dto.From,
            To = dto.To
        };
        _isModalOpen = true;
    }

    private void CloseModal()
    {
        _isModalOpen = false;
    }

    private async Task SaveEmploymentAsync()
    {
        if (_currentModel.To.HasValue && _currentModel.From > _currentModel.To.Value)
        {
            _errorMessage = "Data rozpoczęcia nie może być późniejsza niż data zakończenia.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            HttpResponseMessage response;

            if (_isEditing)
            {
                var updateRequest = new PersonEmploymentUpdateRequest
                {
                    Position = _currentModel.Position,
                    Descrition = _currentModel.Description, // Literówka z Twojego modelu backendowego
                    From = _currentModel.From,
                    To = _currentModel.To
                };
                response = await client.PutAsJsonAsync($"api/person/profile/employments/{_selectedEmploymentId}", updateRequest);
            }
            else
            {
                var createRequest = new PersonEmploymentCreateRequest
                {
                    Regon = _currentModel.Regon,
                    Position = _currentModel.Position,
                    Descrition = _currentModel.Description,
                    From = _currentModel.From,
                    To = _currentModel.To
                };

                response = await client.PostAsJsonAsync("api/person/profile/employments", createRequest);
            }

            if (response.IsSuccessStatusCode)
            {
                _successMessage = _isEditing ? "Zatrudnienie zostało zaktualizowane." : "Dodano nowe zatrudnienie.";
                CloseModal();
                await LoadEmploymentsAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                _errorMessage = "Podano błędne dane (np. nieprawidłowe daty działania firmy dla tego REGONu).";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _errorMessage = "Nie znaleziono firmy o podanym numerze REGON lub zatrudnienia.";
            }
            else
            {
                _errorMessage = "Nie udało się zapisać danych.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd podczas komunikacji z serwerem.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteEmploymentAsync(Guid employmentId)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var response = await client.DeleteAsync($"api/person/profile/employments/{employmentId}");

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Wpis o zatrudnieniu został usunięty.";

                if (_employments.Count == 1 && _currentPage > 1)
                    _currentPage--;

                await LoadEmploymentsAsync();
            }
            else
            {
                _errorMessage = "Nie udało się usunąć wpisu.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
    }
}