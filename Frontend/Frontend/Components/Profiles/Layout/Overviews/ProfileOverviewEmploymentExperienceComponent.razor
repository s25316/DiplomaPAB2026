@using Diploma.Models.PersonEmployments
@using Diploma.Models.Shared
@using static GUS.REGON.Models.Responses.Report

@inject IBackendHttpClientFactory HttpClientFactory
@inject IRegonService RegonService

<div class="container my-4">
    <h3>Historia Zatrudnienia</h3>
    <hr />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <!-- Pasek narzędzi: Sortowanie i Liczba elementów na stronie -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body bg-light rounded">
            <div class="row align-items-center g-3">
                <div class="col-md-7 d-flex flex-wrap gap-2 align-items-center">
                    <label class="form-label mb-0 text-nowrap">Sortuj:</label>
                    <select class="form-select form-select-sm w-auto" @value="_selectedOrderBy" @onchange="OnOrderByChanged">
                        <option value="@PersonEmploymentQueryParameters.PersonEmploymentOrderBy.From">Data rozpoczęcia</option>
                        <option value="@PersonEmploymentQueryParameters.PersonEmploymentOrderBy.Position">Stanowisko</option>
                    </select>
                    <select class="form-select form-select-sm w-auto" @value="_selectedOrder" @onchange="OnOrderChanged">
                        <option value="@Order.Descending">Malejąco</option>
                        <option value="@Order.Ascending">Rosnąco</option>
                    </select>
                </div>
                <div class="col-md-5 d-flex justify-content-md-end align-items-center gap-2">
                    <label class="form-label mb-0 text-nowrap">Na stronie:</label>
                    <select class="form-select form-select-sm w-auto" @value="_itemsPerPage" @onchange="OnItemsPerPageChanged">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- SEKCJA: Lista wpisów zatrudnienia w formacie blokowym -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">
            <strong>Wpisy zatrudnienia</strong>
        </div>
        <div class="card-body bg-light">
            @if (_isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Ładowanie historii zatrudnienia...</p>
                </div>
            }
            else if (_employments == null || !_employments.Any())
            {
                <p class="text-muted mb-0">Brak zapisanych wpisów zatrudnienia.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var employment in _employments)
                    {
                        var isExpanded = _expandedRowIds.Contains(employment.EmploymentId);
                        _companyDictionary.TryGetValue(employment.Regon, out var company);
                        var companyName = company?.Institution?.Nazwa ?? "Brak nazwy";

                        <div class="col-12">
                            <div class="card shadow-sm @(isExpanded ? "border-primary" : "border-0")">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <!-- Główny układ: Firma i Stanowisko -->
                                        <div class="col-md-9 clickable-area" @onclick="() => ToggleRow(employment.EmploymentId)">
                                            <h5 class="text-dark mb-1">
                                                <i class="bi bi-building me-1 text-secondary"></i> <strong>@companyName</strong>
                                            </h5>
                                            <h6 class="text-primary mb-2">
                                                <i class="bi bi-briefcase me-1"></i> @employment.Position
                                            </h6>
                                            <small class="text-muted">
                                                Okres: <strong>@employment.From.ToString("yyyy-MM-dd")</strong> do <strong>@(employment.To.HasValue ? employment.To.Value.ToString("yyyy-MM-dd") : "Obecnie")</strong> |
                                                REGON: <code>@employment.Regon</code>
                                            </small>
                                        </div>

                                        <!-- Przycisk szczegółów -->
                                        <div class="col-md-3 text-md-end mt-3 mt-md-0">
                                            <button class="btn btn-info btn-sm text-white" @onclick="() => ToggleRow(employment.EmploymentId)">
                                                @(isExpanded ? "Ukryj" : "Szczegóły")
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Rozwijana sekcja szczegółów -->
                                    @if (isExpanded)
                                    {
                                        <hr class="my-3 text-muted" />
                                        <div class="card bg-white border-info shadow-sm mt-3">
                                            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-2">
                                                <span>Szczegóły zatrudnienia</span>
                                                <button class="btn-close btn-close-white btn-sm" @onclick="() => ToggleRow(employment.EmploymentId)"></button>
                                            </div>
                                            <div class="card-body">
                                                <!-- Opis stanowiska / obowiązki -->
                                                <div class="mb-4">
                                                    <h6 class="text-primary fw-bold"><i class="bi bi-card-text me-1"></i> Opis stanowiska / Obowiązki</h6>
                                                    <div class="text-dark p-3 bg-light rounded" style="white-space: pre-line;">
                                                        @(!string.IsNullOrWhiteSpace(employment.Description) ? employment.Description : "Brak opisu dla tego stanowiska.")
                                                    </div>
                                                </div>

                                                <hr class="text-muted" />

                                                <!-- Szczegóły pracodawcy GUS -->
                                                <div>
                                                    <h6 class="text-primary fw-bold"><i class="bi bi-building me-1"></i> Szczegóły pracodawcy (GUS)</h6>
                                                    @if (company != null)
                                                    {
                                                        <RegonInstitutionDetailsView Institution="company" />
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted mb-0">Brak danych GUS dla podanego numeru REGON.</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Paginacja -->
                @if (_totalPages > 1)
                {
                    <nav class="d-flex justify-content-between align-items-center mt-4">
                        <span class="text-muted small">Strona @_currentPage z @_totalPages (Łącznie: @_totalCount)</span>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Poprzednia</button>
                            </li>
                            @for (int i = 1; i <= _totalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                                </li>
                            }
                            <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Następna</button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid PersonId { get; set; }

    private Dictionary<string, Full> _companyDictionary = new();
    private List<PersonEmploymentDto> _employments = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private HashSet<Guid> _expandedRowIds = new();

    private PersonEmploymentQueryParameters.PersonEmploymentOrderBy _selectedOrderBy = PersonEmploymentQueryParameters.PersonEmploymentOrderBy.From;
    private Order _selectedOrder = Order.Descending;
    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int _totalCount = 0;
    private int _totalPages = 1;

    protected override async Task OnParametersSetAsync()
    {
        if (PersonId != Guid.Empty)
        {
            await LoadEmploymentsAsync();
        }
    }

    private void ToggleRow(Guid employmentId)
    {
        if (_expandedRowIds.Contains(employmentId))
        {
            _expandedRowIds.Remove(employmentId);
        }
        else
        {
            _expandedRowIds.Add(employmentId);
        }
    }

    private async Task LoadEmploymentsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var url = $"api/persons/{PersonId}/employments?OrderBy={(int)_selectedOrderBy}&Order={(int)_selectedOrder}&Pagination.Page={_currentPage}&Pagination.ItemsPerPage={_itemsPerPage}";
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Response<PersonEmploymentDto>>();
                if (result != null)
                {
                    _employments = result.Items?.ToList() ?? new();
                    _totalCount = result.Pagination.TotalCount;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / _itemsPerPage);

                    var regons = _employments.Select(i => i.Regon).ToHashSet();
                    var companies = await RegonService.GetAsync(regons);
                    if (companies is not null)
                        _companyDictionary = companies.ToDictionary(i => i.Regon);

                    if (_totalPages == 0) _totalPages = 1;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _errorMessage = "Brak dostępu do historii zatrudnienia tej osoby.";
            }
            else
            {
                _errorMessage = "Nie udało się pobrać historii zatrudnienia.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnOrderByChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<PersonEmploymentQueryParameters.PersonEmploymentOrderBy>(e.Value?.ToString(), out var parsed))
        {
            _selectedOrderBy = parsed;
            _currentPage = 1;
            await LoadEmploymentsAsync();
        }
    }

    private async Task OnOrderChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Order>(e.Value?.ToString(), out var parsed))
        {
            _selectedOrder = parsed;
            _currentPage = 1;
            await LoadEmploymentsAsync();
        }
    }

    private async Task OnItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _itemsPerPage = parsed;
            _currentPage = 1;
            await LoadEmploymentsAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        _expandedRowIds.Clear();
        await LoadEmploymentsAsync();
    }
}