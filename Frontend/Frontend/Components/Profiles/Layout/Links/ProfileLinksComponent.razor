@using Diploma.Models.PersonUris
@using Diploma.Models.Shared
@inject IBackendHttpClientFactory HttpClientFactory

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i> Linki </h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg me-1"></i> Dodaj link
        </button>
    </div>
    <div class="card-body bg-light">

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- Pasek narzędzi: Sortowanie i Liczba elementów na stronie -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-6 d-flex gap-2 align-items-center">
                <label class="form-label mb-0 text-nowrap">Sortuj:</label>
                <select class="form-select form-select-sm" @value="_selectedOrderBy" @onchange="OnOrderByChanged">
                    <option value="@PersonUriQueryParameters.PersonUriOrderBy.Name">Nazwa</option>
                    <option value="@PersonUriQueryParameters.PersonUriOrderBy.CreatedAt">Data utworzenia</option>
                </select>
                <select class="form-select form-select-sm" @value="_selectedOrder" @onchange="OnOrderChanged">
                    <option value="@Order.Ascending">Rosnąco</option>
                    <option value="@Order.Descending">Malejąco</option>
                </select>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0 gap-2">
                <label class="form-label mb-0 text-nowrap">Na stronie:</label>
                <select class="form-select form-select-sm w-auto" @value="_itemsPerPage" @onchange="OnItemsPerPageChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Ładowanie linków...</p>
            </div>
        }
        else if (_links == null || !_links.Any())
        {
            <div class="text-center text-muted py-4">
                <p class="mb-0">Brak dodanych linków.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var link in _links)
                {
                    var isSelected = _selectedLinkId == link.UriId;

                    <div class="col-12">
                        <div class="card shadow-sm @(isSelected ? "border-primary" : "border-0")">
                            <div class="card-body">
                                <div class="row align-items-center">

                                    <!-- Główny układ: Nazwa oraz adres URI -->
                                    <div class="col-md-8" style="cursor: pointer;" @onclick="() => ToggleDetails(link.UriId)">
                                        <h5 class="text-dark mb-1">
                                            <i class="bi bi-globe me-1 text-secondary"></i> <strong>@link.Name</strong>
                                        </h5>
                                        <h6 class="text-primary mb-2">
                                            <a href="@link.Uri" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-truncate d-inline-block" style="max-width: 450px;" @onclick:stopPropagation="true">
                                                @link.Uri <i class="bi bi-box-arrow-up-right small ms-1"></i>
                                            </a>
                                        </h6>
                                    </div>

                                    <!-- Przyciski akcji -->
                                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                        <button class="btn btn-info btn-sm me-1 text-white" @onclick="() => ToggleDetails(link.UriId)">
                                            @(isSelected ? "Ukryj" : "Szczegóły")
                                        </button>
                                        <button class="btn btn-warning btn-sm me-1" @onclick="() => OpenEditModal(link)">Edytuj</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteLinkAsync(link.UriId)">Usuń</button>
                                    </div>
                                </div>

                                <!-- Rozwijana sekcja szczegółów bezpośrednio w bloku -->
                                @if (isSelected)
                                {
                                    <hr class="my-3 text-muted" />
                                    <div class="card bg-white border-info shadow-sm mt-3">
                                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-2">
                                            <span>Szczegóły linku</span>
                                            <button class="btn-close btn-close-white btn-sm" @onclick="CloseDetails"></button>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <h6 class="text-primary fw-bold">Opis</h6>
                                                <p class="text-dark mb-0" style="white-space: pre-line;">
                                                    @(!string.IsNullOrWhiteSpace(link.Description) ? link.Description : "Brak opisu dla tego linku.")
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Paginacja -->
            @if (_totalPages > 1)
            {
                <nav class="d-flex justify-content-between align-items-center mt-3">
                    <span class="text-muted small">Strona @_currentPage z @_totalPages (Łącznie: @_totalCount)</span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Poprzednia</button>
                        </li>
                        @for (int i = 1; i <= _totalPages; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Następna</button>
                        </li>
                    </ul>
                </nav>
            }
        }

    </div>
</div>

<!-- MODAL DODAWANIA / EDYCJI -->
@if (_isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Zmiana koloru nagłówka dynamicznie w zależności od trybu -->
                <div class="modal-header @(_isEditing ? "bg-warning text-dark" : "")">
                    <h5 class="modal-title">@(_isEditing ? "Edytuj link" : "Dodaj nowy link")</h5>
                    <button type="button" class="btn-close @(_isEditing ? "" : "")" @onclick="CloseModal"></button>
                </div>

                <EditForm Model="_currentModel" OnValidSubmit="SaveLinkAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary class="text-danger mb-3" />

                        @if (!_isEditing)
                        {
                            <div class="mb-3">
                                <label class="form-label">Adres URI</label>
                                <InputText class="form-control" @bind-Value="_currentModel.Uri" placeholder="https://..." />
                                <ValidationMessage For="() => _currentModel.Uri" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Nazwa</label>
                            <InputText class="form-control" @bind-Value="_currentModel.Name" placeholder="np. GitHub" />
                            <ValidationMessage For="() => _currentModel.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Opis</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_currentModel.Description" placeholder="np. Mój główny profil z repozytoriami"></InputTextArea>
                            <ValidationMessage For="() => _currentModel.Description" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Anuluj</button>
                        <button type="submit" class="btn @(_isEditing ? "btn-success" : "btn-primary")" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Zapisz
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<PersonUriDto> _links = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _successMessage;
    private string? _errorMessage;

    private Guid? _selectedLinkId = null;

    private PersonUriQueryParameters.PersonUriOrderBy _selectedOrderBy = PersonUriQueryParameters.PersonUriOrderBy.Name;
    private Order _selectedOrder = Order.Ascending;
    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int _totalCount = 0;
    private int _totalPages = 1;

    private bool _isModalOpen = false;
    private bool _isEditing = false;
    private Guid _selectedUriId;
    private UriFormModel _currentModel = new();

    public class UriFormModel
    {
        [Required(ErrorMessage = "Adres URI jest wymagany.")]
        [Url(ErrorMessage = "Podaj poprawny adres URL.")]
        public string Uri { get; set; } = string.Empty;

        [Required(ErrorMessage = "Nazwa jest wymagana.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Opis jest wymagany.")]
        public string Description { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLinksAsync();
    }

    private void ToggleDetails(Guid uriId)
    {
        if (_selectedLinkId == uriId)
        {
            CloseDetails();
        }
        else
        {
            _selectedLinkId = uriId;
        }
    }

    private void CloseDetails()
    {
        _selectedLinkId = null;
    }

    private async Task LoadLinksAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var url = $"api/person/profile/urls?OrderBy={(int)_selectedOrderBy}&Order={(int)_selectedOrder}&Pagination.Page={_currentPage}&Pagination.ItemsPerPage={_itemsPerPage}";

            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Response<PersonUriDto>>();
                if (result != null)
                {
                    _links = result.Items?.ToList() ?? new();
                    _totalCount = result.Pagination.TotalCount;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / _itemsPerPage);
                    if (_totalPages == 0) _totalPages = 1;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _errorMessage = "Profil jest nieaktywny.";
            }
            else
            {
                _errorMessage = "Nie udało się pobrać listy linków.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnOrderByChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<PersonUriQueryParameters.PersonUriOrderBy>(e.Value?.ToString(), out var parsed))
        {
            _selectedOrderBy = parsed;
            _currentPage = 1;
            await LoadLinksAsync();
        }
    }

    private async Task OnOrderChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Order>(e.Value?.ToString(), out var parsed))
        {
            _selectedOrder = parsed;
            _currentPage = 1;
            await LoadLinksAsync();
        }
    }

    private async Task OnItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _itemsPerPage = parsed;
            _currentPage = 1;
            await LoadLinksAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadLinksAsync();
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _currentModel = new();
        _isModalOpen = true;
    }

    private void OpenEditModal(PersonUriDto dto)
    {
        _isEditing = true;
        _selectedUriId = dto.UriId;
        _currentModel = new UriFormModel
        {
            Uri = dto.Uri,
            Name = dto.Name,
            Description = dto.Description
        };
        _isModalOpen = true;
    }

    private void CloseModal()
    {
        _isModalOpen = false;
    }

    private async Task SaveLinkAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            HttpResponseMessage response;

            if (_isEditing)
            {
                var updateRequest = new PersonUriUpdateRequest
                {
                    Name = _currentModel.Name,
                    Description = _currentModel.Description
                };
                response = await client.PutAsJsonAsync($"api/person/profile/urls/{_selectedUriId}", updateRequest);
            }
            else
            {
                var createRequest = new PersonUriCreateRequest
                {
                    Uri = _currentModel.Uri,
                    Name = _currentModel.Name,
                    Description = _currentModel.Description
                };
                response = await client.PostAsJsonAsync("api/person/profile/urls", createRequest);
            }

            if (response.IsSuccessStatusCode)
            {
                _successMessage = _isEditing ? "Link został zaktualizowany." : "Link został dodany.";
                CloseModal();
                await LoadLinksAsync();
            }
            else
            {
                _errorMessage = "Nie udało się zapisać linku.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd podczas komunikacji z serwerem.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteLinkAsync(Guid uriId)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var response = await client.DeleteAsync($"api/person/profile/urls/{uriId}");

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Link został pomyślnie usunięty.";

                if (_selectedLinkId == uriId)
                {
                    CloseDetails();
                }

                if (_links.Count == 1 && _currentPage > 1)
                    _currentPage--;

                await LoadLinksAsync();
            }
            else
            {
                _errorMessage = "Nie udało się usunąć linku.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
    }
}