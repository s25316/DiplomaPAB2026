@using Diploma.Models.Educations

@inject IBackendHttpClientFactory ClientFactory


<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <strong>Moje dyscypliny naukowe</strong>
        <button class="btn btn-outline-light btn-sm" @onclick="LoadDisciplinesAsync">Odśwież</button>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <p class="text-muted"><em>Ładowanie dyscyplin...</em></p>
        }
        else if (_disciplines == null || !_disciplines.Any())
        {
            <p class="text-muted mb-0">Brak przypisanych dyscyplin naukowych.</p>
        }
        else
        {
            @foreach (var discipline in _disciplines.OrderBy(i => i.Name))
            {
                <span class="badge bg-white text-primary border py-1 px-2" style="font-size: 0.75rem;">
                    @discipline.Name
                </span>
            }
        }
    </div>
</div>

@code {
    private IEnumerable<EducationDisciplineDto>? _disciplines;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDisciplinesAsync();
    }

    private async Task LoadDisciplinesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null)
            {
                return;
            }

            var response = await client.GetAsync("api/person/profile/educations/disciplines");

            if (response.IsSuccessStatusCode)
            {
                _disciplines = await response.Content.ReadFromJsonAsync<IEnumerable<EducationDisciplineDto>>();
                _disciplines = _disciplines?.ToHashSet().ToList() ?? [];
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _disciplines = Enumerable.Empty<EducationDisciplineDto>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _errorMessage = "Profil jest nieaktywny.";
            }
            else
            {
                _errorMessage = $"Wystąpił błąd podczas pobierania dyscyplin (Kod: {response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd sieciowy: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}