@using Diploma.Models.Dictionaries
@using Diploma.Models.PersonEducations

@inject IBackendHttpClientFactory ClientFactory

<div class="container my-4">
    <h3>Zarządzanie wykształceniem</h3>
    <hr />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success" role="alert">@_successMessage</div>
    }

    <!-- SEKCJAPIERWSZA: Lista istniejących wpisów wykształcenia -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <strong>Twoje wpisy wykształcenia</strong>
            <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">Dodaj nowe wykształcenie</button>
        </div>
        <div class="card-body">
            @if (_educations == null)
            {
                <p><em>Ładowanie...</em></p>
            }
            else if (!_educations.Any())
            {
                <p class="text-muted mb-0">Brak zapisanych wpisów wykształcenia.</p>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID Kierunku (Course)</th>
                            <th>ID Instancji</th>
                            <th>Semestr startowy</th>
                            <th>Semestr końcowy</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var edu in _educations)
                        {
                            <tr>
                                <td><code>@edu.EducationCourseId</code></td>
                                <td><code>@(edu.EducationCourseInstanceId?.ToString() ?? "-")</code></td>
                                <td>@(edu.Start?.Semester?.Name ?? "-") (Rok: @(edu.Start?.Year))</td>
                                <td>@(edu.End != null ? $"{edu.End.Semester.Name} (Rok: {edu.End.Year})" : "-")</td>
                                <td class="text-end">
                                    <button class="btn btn-warning btn-sm me-1" @onclick="() => OpenEditModal(edu)">Edytuj</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteEducationAsync(edu.EducationId)">Usuń</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- SEKCJADRUGA: Formularz DODAWANIA (używa RadonSearchComponent) -->
    @if (_isCreating)
    {
        <RadonSearchComponent OnEducationCreated="HandleEducationCreated" />
        <button class="btn btn-secondary mt-2" @onclick="CloseCreateModal">Zamknij</button>
    }

    <!-- SEKCJATRZECIA: Formularz EDYCJI (tylko daty/semestry, brak RadonSearchComponent) -->
    @if (_editingEducationId.HasValue && _editFormModel != null)
    {
        <div class="card border-warning shadow mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <strong>Edycja okresu wykształcenia</strong>
                <button class="btn-close" @onclick="CloseCreateModal"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_editFormModel" OnValidSubmit="SubmitUpdateAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <h6 class="text-primary font-weight-bold">Dane początkowe (Start)</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Rok startu</label>
                            <InputNumber class="form-control" @bind-Value="_editFormModel.StartYear" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Semestr startu</label>
                            <InputSelect class="form-select" @bind-Value="_editFormModel.StartSemestrId">
                                <option value="0">-- Wybierz semestr --</option>
                                @if (_semesters != null)
                                {
                                    @foreach (var sem in _semesters)
                                    {
                                        <option value="@sem.Code">@sem.Name</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="hasEndCheck" @onchange="ToggleEditEndSection" checked="@(_editIncludeEnd)">
                        <label class="form-check-label font-weight-bold" for="hasEndCheck">
                            Określ datę zakończenia (opcjonalnie)
                        </label>
                    </div>

                    @if (_editIncludeEnd)
                    {
                        <h6 class="text-secondary font-weight-bold">Dane końcowe (End)</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Rok końca</label>
                                <InputNumber class="form-control" @bind-Value="_editFormModel.EndYear" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Semestr końca</label>
                                <InputSelect class="form-select" @bind-Value="_editFormModel.EndSemestrId">
                                    <option value="0">-- Wybierz semestr --</option>
                                    @if (_semesters != null)
                                    {
                                        @foreach (var sem in _semesters)
                                        {
                                            <option value="@sem.Code">@sem.Name</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    }

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Zapisz zmiany</button>
                        <button type="button" class="btn btn-secondary ms-2" @onclick="CloseCreateModal">Anuluj</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<PersonEducationDto>? _educations;
    private List<DictionaryItem<int>>? _semesters;
    private bool _isCreating = false;
    private Guid? _editingEducationId = null;
    private bool _editIncludeEnd = false;
    private EditEducationFormModel? _editFormModel;

    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadEducationsAsync();
        await LoadSemestersAsync();
    }

    private async Task LoadEducationsAsync()
    {
        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            _errorMessage = null;
            _educations = await client.GetFromJsonAsync<IEnumerable<PersonEducationDto>>("api/person/profile/educations?OrderBy=1&Order=1");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd podczas pobierania wykształcenia: {ex.Message}";
        }
    }

    private async Task LoadSemestersAsync()
    {
        try
        {
            var client = await ClientFactory.CreateUnAuthorizedClientAsync();
            _semesters = await client.GetFromJsonAsync<List<DictionaryItem<int>>>("api/person/profile/educations/semesters");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd podczas ładowania słownika semestrów: {ex.Message}";
        }
    }

    private void OpenCreateModal()
    {
        _isCreating = true;
        _editingEducationId = null;
        _editFormModel = null;
        _successMessage = null;
    }

    private void OpenEditModal(PersonEducationDto edu)
    {
        _isCreating = false;
        _editingEducationId = edu.EducationId;
        _successMessage = null;

        _editIncludeEnd = edu.End != null;
        _editFormModel = new EditEducationFormModel
        {
            StartYear = edu.Start?.Year ?? 0,
            StartSemestrId = edu.Start?.Semester?.SemestrId ?? 0,
            EndYear = edu.End?.Year,
            EndSemestrId = edu.End?.Semester?.SemestrId
        };
    }

    private void CloseCreateModal()
    {
        _isCreating = false;
        _editingEducationId = null;
        _editFormModel = null;
    }

    private void ToggleEditEndSection(ChangeEventArgs e)
    {
        _editIncludeEnd = (bool)(e.Value ?? false);
        if (_editFormModel != null)
        {
            if (_editIncludeEnd)
            {
                _editFormModel.EndYear = 0;
                _editFormModel.EndSemestrId = 0;
            }
            else
            {
                _editFormModel.EndYear = null;
                _editFormModel.EndSemestrId = null;
            }
        }
    }

    private async Task SubmitUpdateAsync()
    {
        if (!_editingEducationId.HasValue || _editFormModel == null) return;

        var updateRequest = new PersonEducationUpdateRequest
        {
            Start = new EducationSemestrRequestDto
            {
                Year = _editFormModel.StartYear,
                SemestrId = _editFormModel.StartSemestrId
            },
            End = _editIncludeEnd && _editFormModel.EndYear.HasValue && _editFormModel.EndSemestrId.HasValue
                ? new EducationSemestrRequestDto
                {
                    Year = _editFormModel.EndYear.Value,
                    SemestrId = _editFormModel.EndSemestrId.Value
                }
                : null
        };

        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            _errorMessage = null;
            var response = await client.PutAsJsonAsync($"api/person/profile/educations/{_editingEducationId.Value}", updateRequest);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Pomyślnie zaktualizowano wpis wykształcenia!";
                CloseCreateModal();
                await LoadEducationsAsync();
            }
            else
            {
                _errorMessage = "Wystąpił błąd podczas aktualizacji danych (kod: " + response.StatusCode + ")";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd sieciowy: {ex.Message}";
        }
    }

    private async Task DeleteEducationAsync(Guid educationId)
    {
        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            _errorMessage = null;
            var response = await client.DeleteAsync($"api/person/profile/educations/{educationId}");

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Wpis został usunięty.";
                await LoadEducationsAsync();
            }
            else
            {
                _errorMessage = "Nie udało się usunąć wpisu.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd: {ex.Message}";
        }
    }

    private async Task HandleEducationCreated()
    {
        CloseCreateModal();
        _successMessage = "Pomyślnie dodano wpis wykształcenia!";
        await LoadEducationsAsync();
    }

}