@using Diploma.Models.Dictionaries
@using Diploma.Models.PersonEducations
@using RADON.Models.Courses.Responses
@using RADON.Models.Institutions.Responses

@inject IBackendHttpClientFactory ClientFactory
@inject IRadonCourseService CourseService
@inject IRadonInstitutionService InstitutionService

<div class="container my-4">
    <h3>Zarządzanie wykształceniem</h3>
    <hr />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success" role="alert">@_successMessage</div>
    }

    <!-- SEKPCJA PIERWSZA: Lista istniejących wpisów wykształcenia -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <strong>Twoje wpisy wykształcenia</strong>
            <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">Dodaj nowe wykształcenie</button>
        </div>
        <div class="card-body">
            @if (_educations == null)
            {
                <p><em>Ładowanie...</em></p>
            }
            else if (!_educations.Any())
            {
                <p class="text-muted mb-0">Brak zapisanych wpisów wykształcenia.</p>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Uczelnia</th>
                            <th>Kierunek (Course)</th>
                            <th>Semestr startowy</th>
                            <th>Semestr końcowy</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var edu in _educations)
                        {
                            _courseDictionary.TryGetValue(edu.EducationCourseId, out var course);
                            var institutionName = "-";
                            if (course != null && _institutionDictionary != null && _institutionDictionary.TryGetValue(course.InstitutionUuid, out var institution))
                            {
                                institutionName = institution.Names.OrderByDescending(i => i.Date).FirstOrDefault()?.Name ?? "-"; // Założyłem, że obiekt ma właściwość Name (lub dostosuj do swojego modelu)
                            }

                            // Sprawdzamy czy ten wiersz jest aktualnie wybrany w szczegółach
                            var isSelected = _selectedEducation?.EducationId == edu.EducationId;

                            <tr class="@(isSelected ? "table-active" : "")" style="cursor: pointer;" @onclick="() => SelectEducation(edu)">
                                <td><strong>@institutionName</strong></td>
                                <td>@(course?.Name ?? edu.EducationCourseId.ToString())</td>
                                <td>@(edu.Start?.Semester?.Name ?? "-") (Rok: @(edu.Start?.Year))</td>
                                <td>@(edu.End != null ? $"{edu.End.Semester.Name} (Rok: {edu.End.Year})" : "-")</td>
                                <td class="text-end" @onclick:stopPropagation="true">
                                    <button class="btn btn-info btn-sm me-1 text-white" @onclick="() => SelectEducation(edu)">Szczegóły</button>
                                    <button class="btn btn-warning btn-sm me-1" @onclick="() => OpenEditModal(edu)">Edytuj</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteEducationAsync(edu.EducationId)">Usuń</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- SEKPCJA SZCZEGÓŁÓW: Wyświetlanie szczegółów kierunku i uczelnia wybranego rekordu -->
    @if (_selectedEducation != null)
    {
        <div class="card border-info shadow mb-4">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <strong>Szczegóły wybranego wykształcenia</strong>
                <button class="btn-close btn-close-white" @onclick="CloseDetails"></button>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Informacje o kierunku -->
                    <div class="col-md-6 border-end">
                        <h5 class="text-primary">Kierunek studiów</h5>
                        @if (_selectedCourse != null)
                        {
                            <!-- Tutaj podepnij swój komponent RadonCourseDetailsView przekazując odpowiedni parametr -->
                            <RadonCourseDetailsView Course="_selectedCourse" />
                        }
                        else
                        {
                            <p class="text-muted">Brak szczegółów kierunku.</p>
                        }
                    </div>

                    <!-- Informacje o uczelni -->
                    <div class="col-md-6">
                        <h5 class="text-primary">Uczelnia / Instytucja</h5>
                        @if (_selectedInstitution != null)
                        {
                            <!-- Tutaj podepnij swój komponent RadonInstitutionDetailsView -->
                            <RadonInstitutionDetailsView Institution="_selectedInstitution" />
                        }
                        else
                        {
                            <p class="text-muted">Brak szczegółów uczelni.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- FORMULARZ DODAWANIA -->
    @if (_isCreating)
    {
        <RadonSearchComponent OnEducationCreated="HandleEducationCreated" />
        <button class="btn btn-secondary mt-2" @onclick="CloseCreateModal">Zamknij</button>
    }

    <!-- FORMULARZ EDYCJI -->
    @if (_editingEducationId.HasValue && _editFormModel != null)
    {
        <div class="card border-warning shadow mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <strong>Edycja okresu wykształcenia</strong>
                <button class="btn-close" @onclick="CloseCreateModal"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_editFormModel" OnValidSubmit="SubmitUpdateAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <h6 class="text-primary font-weight-bold">Dane początkowe (Start)</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Rok startu</label>
                            <InputNumber class="form-control" @bind-Value="_editFormModel.StartYear" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Semestr startu</label>
                            <InputSelect class="form-select" @bind-Value="_editFormModel.StartSemestrId">
                                <option value="0">-- Wybierz semestr --</option>
                                @if (_semesters != null)
                                {
                                    @foreach (var sem in _semesters)
                                    {
                                        <option value="@sem.Code">@sem.Name</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="hasEndCheck" @onchange="ToggleEditEndSection" checked="@(_editIncludeEnd)">
                        <label class="form-check-label font-weight-bold" for="hasEndCheck">
                            Określ datę zakończenia (opcjonalnie)
                        </label>
                    </div>

                    @if (_editIncludeEnd)
                    {
                        <h6 class="text-secondary font-weight-bold">Dane końcowe (End)</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Rok końca</label>
                                <InputNumber class="form-control" @bind-Value="_editFormModel.EndYear" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Semestr końca</label>
                                <InputSelect class="form-select" @bind-Value="_editFormModel.EndSemestrId">
                                    <option value="0">-- Wybierz semestr --</option>
                                    @if (_semesters != null)
                                    {
                                        @foreach (var sem in _semesters)
                                        {
                                            <option value="@sem.Code">@sem.Name</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    }

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Zapisz zmiany</button>
                        <button type="button" class="btn btn-secondary ms-2" @onclick="CloseCreateModal">Anuluj</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<PersonEducationDto>? _educations;
    private Dictionary<Guid, Course>? _courseDictionary;
    private Dictionary<Guid, Institution>? _institutionDictionary;
    private List<DictionaryItem<int>>? _semesters;

    private bool _isCreating = false;
    private Guid? _editingEducationId = null;
    private bool _editIncludeEnd = false;
    private EditEducationFormModel? _editFormModel;

    // Pola do obsługi szczegółów wybranego rekordu
    private PersonEducationDto? _selectedEducation;
    private Course? _selectedCourse;
    private Institution? _selectedInstitution;

    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadEducationsAsync();
        await LoadSemestersAsync();
    }

    private async Task LoadEducationsAsync()
    {
        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            _errorMessage = null;
            _educations = await client.GetFromJsonAsync<IEnumerable<PersonEducationDto>>("api/person/profile/educations?OrderBy=1&Order=1");

            if (_educations is null)
                return;

            var courseIds = _educations.Select(i => i.EducationCourseId).ToHashSet();
            if (!courseIds.Any()) return;

            var courseResponse = await CourseService.GetAsync(new RADON.Models.Courses.QueryParameters
            {
                CourseUuids = courseIds,
                OrderBy = RADON.Models.Courses.QueryParameters.QueryParametersOrderBy.CreationDate,
                Order = RADON.Models.Shared.Order.Ascending,
                Pagination = new RADON.Models.Shared.QueryParametersPagination
                {
                    Page = 1,
                    ItemsPerPage = courseIds.Count
                },
            });

            if (courseResponse?.Items is null)
                return;

            _courseDictionary = courseResponse.Items.ToDictionary(i => i.CourseUuid);
            var institutionIds = courseResponse.Items.Select(i => i.InstitutionUuid).ToHashSet();

            if (!institutionIds.Any()) return;

            var institutionResponse = await InstitutionService.GetAsync(new RADON.Models.Institutions.QueryParameters
            {
                InstitutionUuids = institutionIds,
                OrderBy = RADON.Models.Institutions.QueryParameters.QueryParametersOrderBy.Name,
                Order = RADON.Models.Shared.Order.Ascending,
                Pagination = new RADON.Models.Shared.QueryParametersPagination
                {
                    Page = 1,
                    ItemsPerPage = institutionIds.Count,
                },
            });

            if (institutionResponse?.Items is null)
                return;

            _institutionDictionary = institutionResponse.Items.ToDictionary(i => i.InstitutionUuid);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd podczas pobierania wykształcenia: {ex.Message}";
        }
    }

    private async Task LoadSemestersAsync()
    {
        try
        {
            var client = await ClientFactory.CreateUnAuthorizedClientAsync();
            _semesters = await client.GetFromJsonAsync<List<DictionaryItem<int>>>("api/person/profile/educations/semesters");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd podczas ładowania słownika semestrów: {ex.Message}";
        }
    }

    // Metoda wywoływana przy kliknięciu w wiersz lub przycisk "Szczegóły"
    private void SelectEducation(PersonEducationDto edu)
    {
        _selectedEducation = edu;

        // Pobieramy Course ze słownika
        _selectedCourse = null;
        _selectedInstitution = null;

        if (_courseDictionary != null && _courseDictionary.TryGetValue(edu.EducationCourseId, out var course))
        {
            _selectedCourse = course;

            // Pobieramy Institution ze słownika na podstawie Course.InstitutionUuid
            if (_institutionDictionary != null && _institutionDictionary.TryGetValue(course.InstitutionUuid, out var inst))
            {
                _selectedInstitution = inst;
            }
        }
    }

    private void CloseDetails()
    {
        _selectedEducation = null;
        _selectedCourse = null;
        _selectedInstitution = null;
    }

    private void OpenCreateModal()
    {
        _isCreating = true;
        _editingEducationId = null;
        _editFormModel = null;
        _successMessage = null;
        CloseDetails();
    }

    private void OpenEditModal(PersonEducationDto edu)
    {
        _isCreating = false;
        _editingEducationId = edu.EducationId;
        _successMessage = null;
        CloseDetails();

        _editIncludeEnd = edu.End != null;
        _editFormModel = new EditEducationFormModel
        {
            StartYear = edu.Start?.Year ?? 0,
            StartSemestrId = edu.Start?.Semester?.SemestrId ?? 0,
            EndYear = edu.End?.Year,
            EndSemestrId = edu.End?.Semester?.SemestrId
        };
    }

    private void CloseCreateModal()
    {
        _isCreating = false;
        _editingEducationId = null;
        _editFormModel = null;
    }

    private void ToggleEditEndSection(ChangeEventArgs e)
    {
        _editIncludeEnd = (bool)(e.Value ?? false);
        if (_editFormModel != null)
        {
            if (_editIncludeEnd)
            {
                _editFormModel.EndYear = 0;
                _editFormModel.EndSemestrId = 0;
            }
            else
            {
                _editFormModel.EndYear = null;
                _editFormModel.EndSemestrId = null;
            }
        }
    }

    private async Task SubmitUpdateAsync()
    {
        if (!_editingEducationId.HasValue || _editFormModel == null) return;

        var updateRequest = new PersonEducationUpdateRequest
        {
            Start = new EducationSemestrRequestDto
            {
                Year = _editFormModel.StartYear,
                SemestrId = _editFormModel.StartSemestrId
            },
            End = _editIncludeEnd && _editFormModel.EndYear.HasValue && _editFormModel.EndSemestrId.HasValue
                ? new EducationSemestrRequestDto
                {
                    Year = _editFormModel.EndYear.Value,
                    SemestrId = _editFormModel.EndSemestrId.Value
                }
                : null
        };

        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            _errorMessage = null;
            var response = await client.PutAsJsonAsync($"api/person/profile/educations/{_editingEducationId.Value}", updateRequest);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Pomyślnie zaktualizowano wpis wykształcenia!";
                CloseCreateModal();
                await LoadEducationsAsync();
            }
            else
            {
                _errorMessage = "Wystąpił błąd podczas aktualizacji danych (kod: " + response.StatusCode + ")";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd sieciowy: {ex.Message}";
        }
    }

    private async Task DeleteEducationAsync(Guid educationId)
    {
        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            _errorMessage = null;
            var response = await client.DeleteAsync($"api/person/profile/educations/{educationId}");

            if (response.IsSuccessStatusCode)
            {
                if (_selectedEducation?.EducationId == educationId)
                {
                    CloseDetails();
                }
                _successMessage = "Wpis został usunięty.";
                await LoadEducationsAsync();
            }
            else
            {
                _errorMessage = "Nie udało się usunąć wpisu.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd: {ex.Message}";
        }
    }

    private async Task HandleEducationCreated()
    {
        CloseCreateModal();
        _successMessage = "Pomyślnie dodano wpis wykształcenia!";
        await LoadEducationsAsync();
    }
}