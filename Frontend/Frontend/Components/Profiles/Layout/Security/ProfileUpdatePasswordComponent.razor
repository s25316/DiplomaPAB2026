@using Diploma.Models.Persons.Authentication
@inject IBackendHttpClientFactory HttpClientFactory

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Zmiana hasła</h5>
    </div>
    <div class="card-body">

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label for="oldPassword" class="form-label">Obecne hasło</label>
                <InputText id="oldPassword" type="password" class="form-control" @bind-Value="_model.OldPassword" />
                <ValidationMessage For="() => _model.OldPassword" />
            </div>

            <div class="mb-3">
                <label for="newPassword" class="form-label">Nowe hasło</label>
                <InputText id="newPassword" type="password" class="form-control" @bind-Value="_model.NewPassword" />
                <ValidationMessage For="() => _model.NewPassword" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Zapisywanie...</span>
                }
                else
                {
                    <span>Zmień hasło</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private PersonUpdatePasswordRequestModel _model = new();
    private bool _isLoading = false;
    private string? _successMessage;
    private string? _errorMessage;

    public class PersonUpdatePasswordRequestModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Obecne hasło jest wymagane.")]
        public string OldPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nowe hasło jest wymagane.")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Nowe hasło musi mieć co najmniej 6 znaków.")]
        public string NewPassword { get; set; } = string.Empty;
    }

    private async Task HandleSubmitAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            using var client = await HttpClientFactory.CreateAuthorizedClientAsync();
            if (client is null)
                return;

            var requestBody = new PersonUpdatePasswordRequest
            {
                OldPassword = _model.OldPassword,
                NewPassword = _model.NewPassword
            };

            using var response = await client.PostAsJsonAsync("api/person/profile/password", requestBody);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Hasło zostało pomyślnie zmienione.";
                _model = new();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();

                if (!string.IsNullOrWhiteSpace(errorContent) && response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    _errorMessage = errorContent;
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    _errorMessage = "Nie udało się zmienić hasła. Sprawdź poprawność obecnego hasła.";
                }
                else
                {
                    _errorMessage = $"Wystąpił nieoczekiwany błąd (Kod: {(int)response.StatusCode}).";
                }
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}