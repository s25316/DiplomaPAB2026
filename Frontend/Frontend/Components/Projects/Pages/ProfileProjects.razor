@page "/profile/projects"
@inject IJSRuntime JSRuntime
@using Diploma.Models.Projects
@using Diploma.Models.Shared

@inject IBackendHttpClientFactory ClientFactory

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-kanban me-2"></i> Moje projekty </h5>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg me-1"></i> Dodaj projekt
        </button>
    </div>
    <div class="card-body bg-light">

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- Pasek narzędzi: Sortowanie i Liczba elementów na stronie -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-6 d-flex gap-2 align-items-center">
                <label class="form-label mb-0 text-nowrap">Sortuj:</label>
                <select class="form-select form-select-sm" @value="_selectedOrderBy" @onchange="OnOrderByChanged">
                    <option value="1">Tytuł</option>
                    <option value="2">Data utworzenia</option>
                </select>
                <select class="form-select form-select-sm" @value="_selectedOrder" @onchange="OnOrderChanged">
                    <option value="1">Rosnąco</option>
                    <option value="2">Malejąco</option>
                </select>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0 gap-2">
                <label class="form-label mb-0 text-nowrap">Na stronie:</label>
                <select class="form-select form-select-sm w-auto" @value="_itemsPerPage" @onchange="OnItemsPerPageChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Ładowanie projektów...</p>
            </div>
        }
        else if (_projects == null || !_projects.Any())
        {
            <div class="text-center text-muted py-4">
                <p class="mb-0">Brak projektów spełniających kryteria.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var project in _projects)
                {
                    var isSelected = _selectedProjectId == project.ProjectId;

                    <div class="col-12">
                        <div class="card shadow-sm @(isSelected ? "border-primary" : "border-0")">
                            <div class="card-body">
                                <div class="row align-items-center">

                                    <!-- Główny układ: Tytuł, statusy i skrócone info -->
                                    <div class="col-md-8" style="cursor: pointer;" @onclick="() => ToggleDetails(project.ProjectId)">
                                        <h5 class="text-dark mb-1">
                                            <i class="bi bi-folder2-open me-1 text-secondary"></i> <strong>@project.Title</strong>
                                        </h5>
                                        <div class="mb-2">
                                            <span class="badge @(project.IsVisible ? "bg-success" : "bg-secondary") me-1">
                                                @(project.IsVisible ? "Publiczny" : "Prywatny")
                                            </span>
                                            <span class="badge @(project.IsAvailableRecruitment ? "bg-info text-dark" : "bg-light text-dark border")">
                                                @(project.IsAvailableRecruitment ? "Rekrutacja otwarta" : "Rekrutacja zamknięta")
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Przyciski akcji -->
                                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                        <button class="btn btn-info btn-sm me-1 text-white" @onclick="() => ToggleDetails(project.ProjectId)">
                                            @(isSelected ? "Ukryj" : "Szczegóły")
                                        </button>
                                        <button class="btn btn-warning btn-sm me-1" @onclick="() => OpenEditModal(project)">Edytuj</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteProjectAsync(project.ProjectId)">Usuń</button>
                                    </div>
                                </div>

                                <!-- Rozwijana sekcja szczegółów bezpośrednio w bloku -->
                                @if (isSelected)
                                {
                                    <hr class="my-3 text-muted" />
                                    <div class="card bg-white border-info shadow-sm mt-3">
                                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-2">
                                            <span>Szczegóły projektu</span>
                                            <button class="btn-close btn-close-white btn-sm" @onclick="CloseDetails"></button>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <h6 class="text-primary fw-bold">Opis</h6>
                                                <p class="text-dark mb-3" style="white-space: pre-line;">
                                                    @(!string.IsNullOrWhiteSpace(project.Description) ? project.Description : "Brak opisu dla tego projektu.")
                                                </p>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top text-muted small">
                                                <span>Utworzono: @project.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                                <code>ID: @project.ProjectId</code>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Paginacja -->
            @if (_totalPages > 1)
            {
                <nav class="d-flex justify-content-between align-items-center mt-3">
                    <span class="text-muted small">Strona @_currentPage z @_totalPages (Łącznie: @_totalCount)</span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Poprzednia</button>
                        </li>
                        @for (int i = 1; i <= _totalPages; i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(pageNumber == _currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Następna</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

<!-- MODAL DODAWANIA / EDYCJI -->
@if (_isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header @(_isEditing ? "bg-warning text-dark" : "")">
                    <h5 class="modal-title">@(_isEditing ? "Edytuj projekt" : "Utwórz nowy projekt")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <EditForm Model="_currentModel" OnValidSubmit="SaveProjectAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Tytuł</label>
                            <InputText class="form-control" @bind-Value="_currentModel.Title" placeholder="Wpisz tytuł projektu..." />
                            <ValidationMessage For="@(() => _currentModel.Title)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Opis</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_currentModel.Description" placeholder="Wpisz opis projektu..." />
                            <ValidationMessage For="@(() => _currentModel.Description)" />
                        </div>

                        @if (_isEditing)
                        {
                            <div class="mb-3 form-check form-switch">
                                <InputCheckbox class="form-check-input" @bind-Value="_currentModel.IsVisible" id="isVisibleCheck" />
                                <label class="form-check-label fw-bold" for="isVisibleCheck">
                                    @(_currentModel.IsVisible ? "Projekt publiczny (Upubliczniony)" : "Projekt prywatny (Ukryty)")
                                </label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Anuluj</button>
                        <button type="submit" class="btn @(_isEditing ? "btn-success" : "btn-primary")" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Zapisz
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<ProjectDto> _projects = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _successMessage;
    private string? _errorMessage;

    private Guid? _selectedProjectId = null;

    private int _selectedOrderBy = 2;
    private int _selectedOrder = 2;
    private int _currentPage = 1;
    private int _itemsPerPage = 5;
    private int _totalCount = 0;
    private int _totalPages = 1;

    private bool _isModalOpen = false;
    private bool _isEditing = false;
    private Guid _selectedEditProjectId;
    private ProjectFormModel _currentModel = new();

    public class ProjectFormModel
    {
        [Required(ErrorMessage = "Tytuł jest wymagany.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Opis jest wymagany.")]
        public string Description { get; set; } = string.Empty;

        public bool IsVisible { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private void ToggleDetails(Guid projectId)
    {
        if (_selectedProjectId == projectId)
        {
            CloseDetails();
        }
        else
        {
            _selectedProjectId = projectId;
        }
    }

    private void CloseDetails()
    {
        _selectedProjectId = null;
    }

    private async Task LoadProjectsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var url = $"api/projects?OrderBy={_selectedOrderBy}&Order={_selectedOrder}&Pagination.Page={_currentPage}&Pagination.ItemsPerPage={_itemsPerPage}";

            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Response<ProjectDto>>();
                if (result != null)
                {
                    _projects = result.Items?.ToList() ?? new();
                    _totalCount = result.Pagination.TotalCount;
                    _totalPages = (int)Math.Ceiling((double)_totalCount / _itemsPerPage);
                    if (_totalPages == 0) _totalPages = 1;
                }
            }
            else
            {
                _errorMessage = "Nie udało się pobrać listy projektów.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnOrderByChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrderBy = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task OnOrderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _selectedOrder = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task OnItemsPerPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            _itemsPerPage = parsed;
            _currentPage = 1;
            await LoadProjectsAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadProjectsAsync();
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _currentModel = new();
        _isModalOpen = true;
    }

    private void OpenEditModal(ProjectDto dto)
    {
        _isEditing = true;
        _selectedEditProjectId = dto.ProjectId;
        _currentModel = new ProjectFormModel
        {
            Title = dto.Title,
            Description = dto.Description,
            IsVisible = dto.IsVisible
        };
        _isModalOpen = true;
    }

    private void CloseModal()
    {
        _isModalOpen = false;
    }

    private async Task SaveProjectAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            HttpResponseMessage response;

            if (_isEditing)
            {
                var updateRequest = new ProjectUpdateRequest
                {
                    Title = _currentModel.Title,
                    Description = _currentModel.Description,
                    IsVisible = _currentModel.IsVisible
                };
                response = await client.PutAsJsonAsync($"api/projects/{_selectedEditProjectId}", updateRequest);
            }
            else
            {
                var createRequest = new ProjectCreateRequest
                {
                    Title = _currentModel.Title,
                    Description = _currentModel.Description
                };
                response = await client.PostAsJsonAsync("api/projects", createRequest);
            }

            if (response.IsSuccessStatusCode)
            {
                _successMessage = _isEditing ? "Projekt został zaktualizowany." : "Projekt został utworzony.";
                CloseModal();
                await LoadProjectsAsync();
            }
            else
            {
                _errorMessage = "Nie udało się zapisać projektu.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd podczas komunikacji z serwerem.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteProjectAsync(Guid projectId)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var response = await client.DeleteAsync($"api/projects/{projectId}");

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Projekt został pomyślnie usunięty.";

                if (_selectedProjectId == projectId)
                {
                    CloseDetails();
                }

                if (_projects.Count == 1 && _currentPage > 1)
                    _currentPage--;

                await LoadProjectsAsync();
            }
            else
            {
                _errorMessage = "Nie udało się usunąć projektu.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
    }

    private class ProjectCreateFormModel
    {
        [Required(ErrorMessage = "Tytuł jest wymagany.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Opis jest wymagany.")]
        public string Description { get; set; } = string.Empty;
    }

    private class ProjectEditFormModel
    {
        [Required(ErrorMessage = "Tytuł jest wymagany.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Opis jest wymagany.")]
        public string Description { get; set; } = string.Empty;

        public bool IsVisible { get; set; }
    }
}