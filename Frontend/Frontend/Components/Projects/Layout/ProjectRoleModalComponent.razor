@using System.ComponentModel.DataAnnotations

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header @(IsEditing ? "bg-warning text-dark" : "bg-primary text-white")">
                    <h5 class="modal-title">
                        <i class="bi @(IsEditing ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(IsEditing ? "Edytuj rolę" : "Dodaj nową rolę")
                    </h5>
                    <button type="button" class="btn-close @(IsEditing ? "" : "btn-close-white")" @onclick="OnClose"></button>
                </div>

                <EditForm Model="Model" OnValidSubmit="OnSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body bg-light">
                        <ValidationSummary class="text-danger small mb-3" />

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 small mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ErrorMessage
                            </div>
                        }

                        <div class="card border-0 shadow-sm p-3 mb-3">
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-secondary">Tytuł</label>
                                <InputText @bind-Value="Model.Title" class="form-control" placeholder="Wpisz tytuł roli..." />
                                <ValidationMessage For="() => Model.Title" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-secondary">Opis</label>
                                <InputTextArea @bind-Value="Model.Description" class="form-control" rows="3" placeholder="Wpisz opis roli..." />
                                <ValidationMessage For="() => Model.Description" class="text-danger small" />
                            </div>

                            @if (IsEditing)
                            {
                                <div class="mb-0 form-check form-switch">
                                    <InputCheckbox class="form-check-input" @bind-Value="Model.IsAvailableRecruitment" id="roleRecruitmentCheckModal" />
                                    <label class="form-check-label fw-bold small text-secondary" for="roleRecruitmentCheckModal">
                                        @(Model.IsAvailableRecruitment ? "Rekrutacja otwarta" : "Rekrutacja zamknięta")
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer bg-white">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="OnClose">Anuluj</button>
                        <button type="submit" class="btn @(IsEditing ? "btn-success" : "btn-primary") btn-sm px-4" disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Zapisz
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public RoleFormModel Model { get; set; } = new();
    [Parameter] public string? ErrorMessage { get; set; } = null;

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    public class RoleFormModel
    {
        [Required(ErrorMessage = "Tytuł jest wymagany.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Opis jest wymagany.")]
        public string Description { get; set; } = string.Empty;

        public bool IsAvailableRecruitment { get; set; } = true;
    }
}