@using Diploma.Models.Projects

<div class="card shadow-sm @(IsSelected ? "border-primary" : "border-0")">
    <div class="card-body">
        <div class="row align-items-center">

            <!-- Główny układ: Tytuł, statusy -->
            <div class="col-md-8" style="cursor: pointer;" @onclick="() => OnToggleDetails.InvokeAsync(Project.ProjectId)">
                <h5 class="text-dark mb-1">
                    <i class="bi bi-folder2-open me-1 text-secondary"></i> <strong>@Project.Title</strong>
                </h5>
                <div class="mb-2">
                    <span class="badge @(Project.IsVisible ? "bg-success" : "bg-secondary") me-1">
                        @(Project.IsVisible ? "Publiczny" : "Prywatny")
                    </span>
                    <span class="badge @(Project.IsAvailableRecruitment ? "bg-info text-dark" : "bg-light text-dark border")">
                        @(Project.IsAvailableRecruitment ? "Rekrutacja otwarta" : "Rekrutacja zamknięta")
                    </span>
                </div>
            </div>

            <!-- Przyciski akcji -->
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <button class="btn btn-info btn-sm me-1 text-white" @onclick="() => OnToggleDetails.InvokeAsync(Project.ProjectId)">
                    @(IsSelected ? "Ukryj" : "Szczegóły")
                </button>
                <button class="btn btn-warning btn-sm me-1" @onclick="() => OnEdit.InvokeAsync(Project)">Edytuj</button>
                <button class="btn btn-danger btn-sm" @onclick="() => OnDelete.InvokeAsync(Project.ProjectId)">Usuń</button>
            </div>
        </div>

        <!-- Rozwijana sekcja szczegółów -->
        @if (IsSelected)
        {
            <hr class="my-3 text-muted" />
            <div class="card bg-white border-info shadow-sm mt-3">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-2">
                    <span>Szczegóły projektu</span>
                    <button class="btn-close btn-close-white btn-sm" @onclick="() => OnCloseDetails.InvokeAsync()"></button>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-primary fw-bold">Opis</h6>
                        <p class="text-dark mb-3" style="white-space: pre-line;">
                            @(!string.IsNullOrWhiteSpace(Project.Description) ? Project.Description : "Brak opisu dla tego projektu.")
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top text-muted small">
                        <span>Utworzono: @Project.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        <code>ID: @Project.ProjectId</code>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public EventCallback<Guid> OnToggleDetails { get; set; }
    [Parameter] public EventCallback OnCloseDetails { get; set; }
    [Parameter] public EventCallback<ProjectDto> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
}