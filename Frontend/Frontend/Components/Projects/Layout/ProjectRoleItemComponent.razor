@using System.ComponentModel.DataAnnotations
@using Diploma.Models.ProjectRoles
@using Diploma.Models.Shared
@using RADON.Models.Dictionaries.Responses
@using RADON.Models.Institutions.Responses

<div class="list-group-item py-3">
    <div class="d-flex justify-content-between align-items-start">
        <div class="flex-grow-1 me-3">
            <!-- Nagłówek roli i statusy -->
            <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                <h6 class="mb-0 fw-bold text-dark">@Role.Title</h6>

                <!-- Status rekrutacji (Otwarta / Zamknięta) -->
                <span class="badge @(Role.IsAvailableRecruitment ? "bg-info text-dark" : "bg-light text-dark border")" style="font-size: 0.7rem;">
                    @(Role.IsAvailableRecruitment ? "Rekrutacja otwarta" : "Rekrutacja zamknięta")
                </span>

                <!-- Status rekrutowania (IsRecruted - jeśli ma wartość) -->
                @if (Role.IsRecruted.HasValue)
                {
                    <span class="badge @(Role.IsRecruted.Value ? "bg-success" : "bg-secondary")" style="font-size: 0.7rem;">
                        @(Role.IsRecruted.Value ? "Zrekrutowany" : "Nie zrekrutowany")
                    </span>
                }
            </div>

            <!-- Opis roli -->
            <p class="mb-2 small text-muted" style="white-space: pre-line;">
                @(!string.IsNullOrWhiteSpace(Role.Description) ? Role.Description : "Brak opisu roli.")
            </p>
        </div>

        <!-- Przyciski akcji roli -->
        <div class="btn-group btn-group-sm flex-shrink-0">
            <button class="btn btn-warning text-dark" @onclick="() => OnEdit.InvokeAsync(Role)">Edytuj</button>
            <button class="btn btn-danger" @onclick="() => OnDelete.InvokeAsync(Role.ProjectRoleId)">Usuń</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(actionError))
    {
        <div class="alert alert-danger py-1 px-2 small mt-2 mb-2">@actionError</div>
    }

    <!-- Sekcja Dyscyplin - na pełnej szerokości -->
    <div class="mt-3 p-2 bg-light rounded border w-100">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small fw-bold text-secondary"><i class="bi bi-book me-1"></i>Dyscypliny:</span>
            <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;" @onclick="ToggleAddDiscipline">
                <i class="bi bi-plus-lg me-1"></i>@(isAddingDiscipline ? "Anuluj" : "Dodaj dyscyplinę")
            </button>
        </div>

        <!-- Formularz dodawania dyscypliny -->
        @if (isAddingDiscipline)
        {
            <div class="card card-body bg-white p-2 mb-2 shadow-sm border-0">
                @if (isLoadingAvailableDisciplines)
                {
                    <div class="d-flex align-items-center">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        <span class="small text-muted">Ładowanie słownika dyscyplin...</span>
                    </div>
                }
                else if (availableDisciplines.Any())
                {
                    <div class="input-group input-group-sm">
                        <select class="form-select" @bind="selectedDisciplineCode">
                            <option value="">-- Wybierz dyscyplinę --</option>
                            @foreach (var d in GetUnassignedDisciplines())
                            {
                                <option value="@d.Code">@d.Name (@d.Code)</option>
                            }
                        </select>
                        <button class="btn btn-success" type="button" @onclick="SaveDisciplineAsync" disabled="@(string.IsNullOrEmpty(selectedDisciplineCode) || isSubmittingDiscipline)">
                            @if (isSubmittingDiscipline)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Zapisz
                        </button>
                    </div>
                }
                else
                {
                    <span class="small text-muted fst-italic">Brak dostępnych dyscyplin w systemie lub wszystkie są już przypisane.</span>
                }
            </div>
        }

        <!-- Lista przypisanych dyscyplin -->
        <div class="d-flex flex-wrap gap-1 align-items-center">
            @if (Role.Disciplines != null && Role.Disciplines.Any())
            {
                @foreach (var discipline in Role.Disciplines.OrderBy(i => i.Discipline.Name))
                {
                    <span class="badge bg-white text-primary border d-flex align-items-center gap-1 py-1 px-2" style="font-size: 0.75rem;">
                        @discipline.Discipline?.Name
                        <button type="button" class="btn-close" style="font-size: 0.5rem;" aria-label="Usuń" @onclick="() => DeleteDisciplineAsync(discipline.ProjectRoleDisciplineId, discipline.Discipline.Code)" @onclick:stopPropagation="true"></button>
                    </span>
                }
            }
            else
            {
                <span class="text-muted small fst-italic">Brak przypisanych dyscyplin</span>
            }
        </div>
    </div>

    <!-- Sekcja Instytucji edukacyjnych -->
    <div class="mt-3 p-2 bg-light rounded border w-100">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small fw-bold text-secondary"><i class="bi bi-mortarboard me-1"></i>Instytucje edukacyjne:</span>
            <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;" @onclick="ToggleAddInstitution">
                <i class="bi bi-plus-lg me-1"></i>@(isAddingInstitution ? "Anuluj" : "Dodaj instytucję")
            </button>
        </div>

        <!-- Formularz/Wyszukiwarka dodawania instytucji -->
        @if (isAddingInstitution)
        {
            <div class="card card-body bg-white p-3 mb-2 shadow-sm border-0">
                <h6 class="text-primary small fw-bold mb-2">Wybierz instytucję z bazy RADON:</h6>
                <RadonInstitutionsComponent OnInstitutionSelected="HandleInstitutionSelected" />

                @if (_selectedNewInstitution != null)
                {
                    <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mt-2 border">
                        <div>
                            <span class="small fw-bold text-dark d-block">@_selectedNewInstitution.Names.OrderByDescending(i => i.Date).FirstOrDefault()?.Name</span>
                            <span class="text-muted" style="font-size: 0.7rem;">UUID: @_selectedNewInstitution.InstitutionUuid</span>
                        </div>
                        <button class="btn btn-success btn-sm" @onclick="SaveInstitutionAsync" disabled="@isSubmittingInstitution">
                            @if (isSubmittingInstitution)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Przypisz instytucję
                        </button>
                    </div>
                }
            </div>
        }

        <!-- Lista przypisanych instytucji -->
        <div class="d-flex flex-wrap gap-1 align-items-center">
            @if (Role.EductionInstitutionIds != null && Role.EductionInstitutionIds.Any())
            {
                @foreach (var institutionLink in Role.EductionInstitutionIds)
                {
                    var institutionId = institutionLink.EductionInstitutionId;
                    var institutionName = institutionId.ToString().Substring(0, 8) + "...";
                    Institution? institution = null;

                    if (_institutionDictionary.TryGetValue(institutionId, out institution))
                    {
                        institutionName = institution.Names?.OrderByDescending(n => n.Date).FirstOrDefault()?.Name ?? institutionId.ToString();
                    }

                    var isInstSelected = _selectedInstitutionId == institutionId;

                    <span class="badge bg-white text-dark border d-inline-flex align-items-center gap-1 py-1 px-2 @(isInstSelected ? "border-primary bg-light" : "")"
                          style="font-size: 0.75rem; cursor: pointer;"
                          title="Kliknij, aby zobaczyć szczegóły uczelni"
                          @onclick="() => ToggleInstitutionDetails(institutionId, institution)">
                        <i class="bi bi-building me-1 text-primary"></i> @institutionName
                        <button type="button" class="btn-close" style="font-size: 0.45rem;" aria-label="Usuń" @onclick="() => DeleteInstitutionAsync(institutionLink.ProjectRoleEductionInstitutionId)" @onclick:stopPropagation="true"></button>
                    </span>
                }
            }
            else
            {
                <span class="text-muted small fst-italic">Brak przypisanych instytucji</span>
            }
        </div>

        <!-- Sekcja szczegółów wybranej instytucji uczelni -->
        @if (_selectedInstitutionId.HasValue)
        {
            <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-primary fw-bold mb-0 small"><i class="bi bi-info-circle me-1"></i>Szczegóły instytucji</h6>
                    <button class="btn-close btn-sm" style="font-size: 0.6rem;" @onclick="CloseInstitutionDetails"></button>
                </div>

                @if (_selectedInstitutionDetails != null)
                {
                    <RadonInstitutionDetailsView Institution="_selectedInstitutionDetails" />
                }
                else
                {
                    <div class="text-center py-2">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="text-muted small ms-2">Ładowanie szczegółów uczelni...</span>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Data utworzenia -->
    <div class="d-flex justify-content-end align-items-center mt-2 pt-2 border-top">
        <div class="text-muted small" style="font-size: 0.75rem;">
            <i class="bi bi-clock me-1"></i>Utworzono: @Role.CreatedAt.ToString("yyyy-MM-dd HH:mm")
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectRoleDto Role { get; set; } = default!;
    [Parameter] public List<Institution> Institutions { get; set; } = default!;
    [Parameter] public EventCallback<ProjectRoleDto> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<ProjectRoleDto> OnRoleUpdated { get; set; }

    [Inject] private IBackendHttpClientFactory ClientFactory { get; set; } = default!;

    private string? actionError;

    // --- Dyscypliny ---
    private bool isAddingDiscipline = false;
    private bool isLoadingAvailableDisciplines = false;
    private bool isSubmittingDiscipline = false;
    private string? selectedDisciplineCode;
    private List<DictionaryItem> availableDisciplines = new();

    // --- Instytucje ---
    private bool isAddingInstitution = false;
    private bool isSubmittingInstitution = false;
    private string? _lastInstitutionIdsHash;
    private int _lastInstitutionsListCount;
    private Institution? _selectedNewInstitution;
    private Dictionary<Guid, Institution> _institutionDictionary = new();

    // --- Stan szczegółów wybranej instytucji z listy ---
    private Guid? _selectedInstitutionId;
    private Institution? _selectedInstitutionDetails;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var currentInstitutionIdsHash = Role.EductionInstitutionIds != null
            ? string.Join(",", Role.EductionInstitutionIds.Select(i => i.EductionInstitutionId).OrderBy(id => id))
            : string.Empty;

        var currentInstitutionsCount = Institutions?.Count ?? 0;

        if (_lastInstitutionIdsHash != currentInstitutionIdsHash || _lastInstitutionsListCount != currentInstitutionsCount)
        {
            _lastInstitutionIdsHash = currentInstitutionIdsHash;
            _lastInstitutionsListCount = currentInstitutionsCount;
            BuildInstitutionDictionary();
        }
    }

    private void BuildInstitutionDictionary()
    {
        _institutionDictionary.Clear();

        if (Role.EductionInstitutionIds != null && Institutions != null)
        {
            var roleIdsSet = Role.EductionInstitutionIds.Select(i => i.EductionInstitutionId).ToHashSet();

            foreach (var inst in Institutions)
            {
                var id = GetInstitutionId(inst);
                if (roleIdsSet.Contains(id))
                {
                    _institutionDictionary[id] = inst;
                }
            }
        }
    }

    private Guid GetInstitutionId(Institution i)
    {
        var prop = i.GetType().GetProperty("InstitutionUuid") ?? i.GetType().GetProperty("Id") ?? i.GetType().GetProperty("Uuid");
        if (prop != null && prop.GetValue(i) is Guid g) return g;
        return i.InstitutionUuid;
    }

    private void ToggleAddDiscipline()
    {
        isAddingDiscipline = !isAddingDiscipline;
        actionError = null;
        selectedDisciplineCode = null;

        if (isAddingDiscipline && !availableDisciplines.Any())
        {
            _ = LoadAvailableDisciplinesAsync();
        }
    }

    private async Task LoadAvailableDisciplinesAsync()
    {
        isLoadingAvailableDisciplines = true;
        actionError = null;
        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var response = await client.GetAsync("api/radon/shared/disciplines");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<DictionaryItem>>();
                if (result != null) availableDisciplines = result;
            }
        }
        catch
        {
            actionError = "Nie udało się pobrać listy dostępnych dyscyplin.";
        }
        finally
        {
            isLoadingAvailableDisciplines = false;
        }
    }

    private IEnumerable<DictionaryItem> GetUnassignedDisciplines()
    {
        var assignedCodes = Role.Disciplines?.Select(d => d.Discipline.Code).ToHashSet() ?? new();
        return availableDisciplines.Where(d => !assignedCodes.Contains(d.Code));
    }

    private async Task SaveDisciplineAsync()
    {
        if (string.IsNullOrEmpty(selectedDisciplineCode)) return;

        isSubmittingDiscipline = true;
        actionError = null;

        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var requestBody = new { DisciplineCode = selectedDisciplineCode };
            var response = await client.PostAsJsonAsync($"api/projects/{Role.ProjectId}/projectRoles/{Role.ProjectRoleId}/disciplines", requestBody);

            if (response.IsSuccessStatusCode)
            {
                isAddingDiscipline = false;
                selectedDisciplineCode = null;
                await OnRoleUpdated.InvokeAsync(Role);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                actionError = !string.IsNullOrWhiteSpace(error) ? error : "Nie udało się dodać dyscypliny.";
            }
        }
        catch
        {
            actionError = "Błąd połączenia z serwerem.";
        }
        finally
        {
            isSubmittingDiscipline = false;
        }
    }

    private async Task DeleteDisciplineAsync(Guid projectRoleDisciplineId, string disciplineCode)
    {
        actionError = null;
        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var requestMessage = new HttpRequestMessage(HttpMethod.Delete, $"api/projects/projectRoles/disciplines/{projectRoleDisciplineId}")
            {
                Content = JsonContent.Create(new { DisciplineCode = disciplineCode })
            };

            var response = await client.SendAsync(requestMessage);

            if (response.IsSuccessStatusCode)
            {
                await OnRoleUpdated.InvokeAsync(Role);
            }
            else
            {
                actionError = "Nie udało się usunąć dyscypliny.";
            }
        }
        catch
        {
            actionError = "Błąd połączenia z serwerem.";
        }
    }

    private void ToggleAddInstitution()
    {
        isAddingInstitution = !isAddingInstitution;
        actionError = null;
        _selectedNewInstitution = null;
    }

    private void HandleInstitutionSelected(Institution institution)
    {
        _selectedNewInstitution = institution;
    }

    private async Task SaveInstitutionAsync()
    {
        if (_selectedNewInstitution == null) return;

        isSubmittingInstitution = true;
        actionError = null;

        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var requestBody = new
            {
                EductioninstitutionId = _selectedNewInstitution.InstitutionUuid
            };

            var response = await client.PostAsJsonAsync($"api/projects/{Role.ProjectId}/projectRoles/{Role.ProjectRoleId}/institutions", requestBody);

            if (response.IsSuccessStatusCode)
            {
                isAddingInstitution = false;
                _selectedNewInstitution = null;
                await OnRoleUpdated.InvokeAsync(Role);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                actionError = !string.IsNullOrWhiteSpace(error) ? error : "Nie udało się dodać instytucji.";
            }
        }
        catch
        {
            actionError = "Błąd połączenia z serwerem.";
        }
        finally
        {
            isSubmittingInstitution = false;
        }
    }

    private async Task DeleteInstitutionAsync(Guid projectRoleEducationInstitutionId)
    {
        actionError = null;
        try
        {
            using var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null) return;

            var response = await client.DeleteAsync($"api/projects/projectRoles/institutions/{projectRoleEducationInstitutionId}");

            if (response.IsSuccessStatusCode)
            {
                // Jeśli usuwamy akurat tę, która była wyświetlana w szczegółach, zamknij widok szczegółów
                await OnRoleUpdated.InvokeAsync(Role);
            }
            else
            {
                actionError = "Nie udało się usunąć instytucji.";
            }
        }
        catch
        {
            actionError = "Błąd połączenia z serwerem.";
        }
    }

    // --- Metody zarządzania widokiem szczegółów przypisanej instytucji ---
    private async Task ToggleInstitutionDetails(Guid institutionId, Institution? institution)
    {
        if (_selectedInstitutionId == institutionId)
        {
            CloseInstitutionDetails();
            return;
        }

        _selectedInstitutionId = institutionId;
        _selectedInstitutionDetails = institution;

        // Jeśli z jakiegoś powodu obiekt nie przeszedł w argumencie, spróbujmy go wyciągnąć ze słownika
        if (_selectedInstitutionDetails == null && _institutionDictionary.TryGetValue(institutionId, out var found))
        {
            _selectedInstitutionDetails = found;
        }

        // Opcjonalnie: jeśli nadal jest null, moglibyśmy dociągnąć z API, ale zazwyczaj słownik je posiada
        await Task.CompletedTask;
    }

    private void CloseInstitutionDetails()
    {
        _selectedInstitutionId = null;
        _selectedInstitutionDetails = null;
    }
}