@using Diploma.Models.Persons.Authentication

<div class="container mt-5" style="max-width: 500px;">
    <h3>Odzyskiwanie hasła</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (currentStep == RecoveryStep.Initiation)
    {
        <!-- KROK 1: Inicjacja odzyskiwania -->
        <p class="text-muted">Wprowadź swoje dane, aby otrzymać instrukcję/kod odzyskiwania hasła.</p>

        <EditForm Model="@initModel" OnValidSubmit="HandleInitiation" FormName="PasswordRecoveryInitForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Login / Email:</label>
                <!-- Dostosuj właściwość modelu do tego, co przyjmuje Twój PersonUpdatePasswordRecoveryInitiationRequest -->
                <InputText @bind-Value="initModel.Email" class="form-control" />
                <ValidationMessage For="@(() => initModel.Email)" />
            </div>

            <button type="submit" class="btn btn-primary">Wyślij kod odzyskiwania</button>
        </EditForm>
    }
    else if (currentStep == RecoveryStep.Recovery)
    {
        <!-- KROK 2: Ustawienie nowego hasła z użyciem operationId -->
        <p class="text-muted">Wprowadź otrzymany kod aktywacyjny oraz nowe hasło.</p>

        <EditForm Model="@recoveryModel" OnValidSubmit="HandleRecovery" FormName="PasswordRecoveryForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Kod odzyskiwania:</label>
                <InputText @bind-Value="recoveryModel.Code" class="form-control" />
                <ValidationMessage For="@(() => recoveryModel.Code)" />
            </div>

            <div class="mb-3">
                <label>Nowe hasło:</label>
                <InputText type="password" @bind-Value="recoveryModel.NewPassword" class="form-control" />
                <ValidationMessage For="@(() => recoveryModel.NewPassword)" />
            </div>

            <button type="submit" class="btn btn-success">Zmień hasło</button>
        </EditForm>
    }
</div>

@code {
    [Parameter] public EventCallback OnSwitchToLogin { get; set; }

    [Inject] private IBackendHttpClientFactory ClientFactory { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private enum RecoveryStep { Initiation, Recovery }
    private RecoveryStep currentStep = RecoveryStep.Initiation;

    private Guid operationId;
    private string? errorMessage;
    private string? successMessage;

    [SupplyParameterFromForm]
    private PersonUpdatePasswordRecoveryInitiation initModel { get; set; } = new();

    [SupplyParameterFromForm]
    private PersonUpdatePasswordRecovery recoveryModel { get; set; } = new();

    // --- KROK 1: Wysłanie żądania inicjacji ---
    private async Task HandleInitiation()
    {
        errorMessage = null;
        successMessage = null;

        var client = await ClientFactory.CreateUnAuthorizedClientAsync();
        var response = await client.PostAsJsonAsync("api/person/profile/password/recovery/initiation", new PersonUpdatePasswordRecoveryInitiationRequest
        {
            Login = initModel.Email,
        });

        if (response.IsSuccessStatusCode)
        {
            // Odbieramy obiekt Initiation, który zawiera OperationId (zgodnie z Twoim endpointem: Ok(initiation))
            var result = await response.Content.ReadFromJsonAsync<PersonUpdatePasswordResult.Initiation>();

            if (result is not null)
            {
                operationId = result.OperationId;
                currentStep = RecoveryStep.Recovery;
                successMessage = "Kod odzyskiwania został wysłany. Sprawdź swoją skrzynkę.";
            }
            else
            {
                errorMessage = "Wystąpił błąd podczas przetwarzania odpowiedzi serwera.";
            }
        }
        else
        {
            errorMessage = "Nie udało się zainicjować odzyskiwania hasła. Sprawdź wpisane dane.";
        }
    }

    // --- KROK 2: Wysłanie nowego hasła z operationId w adresie ---
    private async Task HandleRecovery()
    {
        errorMessage = null;
        successMessage = null;

        var client = await ClientFactory.CreateUnAuthorizedClientAsync();
        var response = await client.PostAsJsonAsync($"api/person/profile/password/recovery/{operationId}", new PersonUpdatePasswordRecoveryRequest
        {
            Code = recoveryModel.Code,
            Password = recoveryModel.NewPassword,
        });

        if (response.IsSuccessStatusCode)
        {
            successMessage = "Hasło zostało pomyślnie zmienione! Za chwilę nastąpi przekierowanie do logowania...";
            StateHasChanged();

            await Task.Delay(3000);
            await OnSwitchToLogin.InvokeAsync();
        }
        else
        {
            errorMessage = "Kod odzyskiwania jest nieprawidłowy lub wygasł.";
        }
    }

    public class PersonUpdatePasswordRecoveryInitiation
    {
        [Required(ErrorMessage = "Email jest wymagany.")]
        public string Email { get; set; } = string.Empty;
    }

    public class PersonUpdatePasswordRecovery
    {
        [Required(ErrorMessage = "Kod jest wymagany.")]
        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "Nowe hasło jest wymagane.")]
        public string NewPassword { get; set; } = string.Empty; 
    }

    public class PersonUpdatePasswordResultInitiationDto
    {
        public Guid OperationId { get; set; }
    }
}