@using Base.Models.ValueObjects.Regony
@using static GUS.REGON.Models.Responses.Report
@inject IRegonService RegonService

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex align-items-center">
        <h5 class="mb-0"><i class="bi bi-building me-2"></i>Wyszukiwarka Instytucji (REGON)</h5>
    </div>
    <div class="card-body">

        <!-- Formularz wyszukiwania -->
        <div class="mb-3">
            <label class="form-label">Numer REGON:</label>
            <div class="input-group">
                <input type="text" class="form-control" @bind="_regonInput" placeholder="np. 012345678" />
                <button class="btn btn-primary" type="button" @onclick="SearchInstitutionsAsync" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    <i class="bi bi-search me-1"></i> Szukaj
                </button>
            </div>
            <div class="form-text">Wprowadź 9 lub 14-cyfrowy numer REGON.</div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- Wyniki wyszukiwania -->
        @if (_isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Pobieranie danych z rejestru REGON...</p>
            </div>
        }
        else if (_institution is not null)
        {
            <div class="mt-4">
                <RegonInstitutionDetailsView Institution="_institution" />

                <div class="mt-3 text-end">
                    <button type="button" class="btn btn-success" @onclick="SelectCompany">
                        <i class="bi bi-check-circle me-1"></i> Wybierz tę firmę do zatrudnienia
                    </button>
                </div>
            </div>
        }
        else if (_hasSearched)
        {
            <div class="text-center text-muted py-4">
                <p class="mb-0">Brak wyników dla podanego numeru REGON.</p>
            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public EventCallback<string> OnRegonSelected { get; set; }

    private string _regonInput = string.Empty;
    private Full? _institution = null;
    private bool _isLoading = false;
    private bool _hasSearched = false;
    private string? _errorMessage;

    private async Task SearchInstitutionsAsync()
    {
        if (string.IsNullOrWhiteSpace(_regonInput))
        {
            _errorMessage = "Wprowadź numer REGON.";
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        _hasSearched = true;
        _institution = null;

        try
        {
            var regon = _regonInput
                .Split(new[] { ',', ' ', '\n', '\r', '-', '_' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(r => r.Trim())
                .Where(r => !string.IsNullOrEmpty(r))
                .Distinct()
                .FirstOrDefault();

            if (string.IsNullOrWhiteSpace(regon))
            {
                _errorMessage = "Nie podano numeru REGON.";
                _isLoading = false;
                return;
            }

            if (!Regon.TryParse(regon, out var _))
            {
                _errorMessage = "Podano niepoprawny numer REGON.";
                _isLoading = false;
                return;
            }

            var response = await RegonService.GetAsync([regon]);

            if (response is not null)
            {
                _institution = response.FirstOrDefault();
                if (_institution == null)
                {
                    _errorMessage = "Nie znaleziono firmy o takim numerze REGON w rejestrze.";
                }
            }
            else
            {
                _errorMessage = "Wystąpił błąd podczas pobierania danych z serwera REGON.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Wystąpił błąd połączenia z serwerem.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectCompany()
    {
        if (_institution != null && !string.IsNullOrEmpty(_institution.Regon))
        {
            await OnRegonSelected.InvokeAsync(_institution.Regon);
        }
    }
}