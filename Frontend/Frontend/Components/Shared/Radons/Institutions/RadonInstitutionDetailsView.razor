@using RADON.Models.Institutions.Responses

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4>@GetLatestName(Institution)</h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <strong>REGON:</strong> @(Institution.Regon ?? "-")
            </div>
            <div class="col-md-4">
                <strong>NIP:</strong> @(Institution.Nip ?? "-")
            </div>
            <div class="col-md-4">
                <strong>KRS:</strong> @(Institution.Krs ?? "-")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Rodzaj instytucji:</strong> @(Institution.InstitutionKind?.Name ?? "-")
            </div>
            <div class="col-md-6">
                <strong>Aktualny status:</strong> @GetLatestStatus(Institution)
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <strong>Data startu:</strong> @Institution.StartDate.ToString("yyyy-MM-dd")
            </div>
            <div class="col-md-4">
                <strong>Data likwidacji (start):</strong> @(Institution.LiquidationStartDate?.ToString("yyyy-MM-dd") ?? "-")
            </div>
            <div class="col-md-4">
                <strong>Data likwidacji:</strong> @(Institution.LiquidationDate?.ToString("yyyy-MM-dd") ?? "-")
            </div>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-4">
                <strong>Strona internetowa:</strong>
                @if (!string.IsNullOrEmpty(Institution.Www))
                {
                    <a href="@Institution.Www" target="_blank">@Institution.Www</a>
                }
                else
                {
                    <span>-</span>
                }
            </div>
            <div class="col-md-4">
                <strong>Email:</strong> @(Institution.Email ?? "-")
            </div>
            <div class="col-md-4">
                <strong>Telefon:</strong> @(Institution.Phone ?? "-")
            </div>
        </div>
    </div>
</div>

<!-- SEKCJA SPECYFICZNA / DODATKOWA (np. dla Uczelni lub Typów instytucji z listy Types) -->
@if (Institution.Types != null && Institution.Types.Any())
{
    <div class="card mb-4 shadow-sm border-info">
        <div class="card-header bg-info text-white">
            <h5>Historia i Typy Instytucji</h5>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                @foreach (var typeSnapshot in Institution.Types.OrderByDescending(t => t.Date))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@typeSnapshot.Type.Name</span>
                        <span class="badge bg-secondary rounded-pill">Od: @typeSnapshot.Date.ToString("yyyy-MM-dd")</span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Institution Institution { get; set; } = null!;

    private string GetLatestName(Institution institution)
    {
        return institution.Names?
            .OrderByDescending(n => n.Date)
            .FirstOrDefault()?
            .Name ?? "Brak nazwy";
    }

    private string GetLatestStatus(Institution institution)
    {
        var latestStatus = institution.Statuses?
            .OrderByDescending(s => s.Date)
            .FirstOrDefault()?
            .Status;

        return latestStatus?.Name ?? "-";
    }
}