@page "/institutions"
@using RADON.Models.Dictionaries.Responses
@using RADON.Models.Institutions
@using RADON.Models.Institutions.Responses
@using RADON.Models.Shared
@inject IBackendHttpClientFactory ClientFactory
@inject IRadonInstitutionService InstitutionService

<h3>Lista Instytucji RADON</h3>

<!-- FORMULARZ Z WALIDACJĄ -->
<EditForm Model="_filterModel" OnValidSubmit="LoadDataAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-danger" />

    <div class="card mb-3 p-3 bg-light">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Nazwa</label>
                <InputText class="form-control" @bind-Value="_filterModel.Name" />
            </div>
            <div class="col-md-4">
                <label class="form-label">REGON</label>
                <InputText class="form-control" @bind-Value="_filterModel.RegonString" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Rodzaj instytucji</label>
                <InputSelect class="form-select" @bind-Value="_filterModel.SelectedKindCode">
                    <option value="">-- Wszystkie --</option>
                    @if (_kinds != null)
                    {
                        @foreach (var kind in _kinds)
                        {
                            <option value="@kind.Code">@kind.Name</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <InputSelect class="form-select" @bind-Value="_filterModel.SelectedStatusCode">
                    <option value="">-- Wszystkie --</option>
                    @if (_statuses != null)
                    {
                        @foreach (var status in _statuses)
                        {
                            <option value="@status.Code">@status.Name</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Typ uczelni</label>
                <InputSelect class="form-select" @bind-Value="_filterModel.SelectedUniversityTypeCode">
                    <option value="">-- Wszystkie --</option>
                    @if (_universityTypes != null)
                    {
                        @foreach (var type in _universityTypes)
                        {
                            <option value="@type.Code">@type.Name</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Typ inst. naukowej</label>
                <InputSelect class="form-select" @bind-Value="_filterModel.SelectedScientificInstitutionTypeCode">
                    <option value="">-- Wszystkie --</option>
                    @if (_scientificInstitutionTypes != null)
                    {
                        @foreach (var type in _scientificInstitutionTypes)
                        {
                            <option value="@type.Code">@type.Name</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="col-md-12 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">Filtruj</button>
                <button type="button" class="btn btn-secondary" @onclick="ResetFiltersAsync">Resetuj</button>
            </div>
        </div>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

<!-- TABELA DANYCH -->
@if (_response == null)
{
    <p><em>Ładowanie danych...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 40px;"></th>
                    <th>Nazwa</th>
                </tr>
            </thead>
            <tbody>
                @if (!_response.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">Brak wyników spełniających kryteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in _response.Items)
                    {
                        bool isExpanded = _expandedUuid == item.InstitutionUuid;

                        <!-- Główny wiersz -->
                        <tr @onclick="() => ToggleRow(item.InstitutionUuid)" style="cursor: pointer;" class="@(isExpanded ? "table-active" : "")">
                            <td class="text-center">
                                <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") text-muted"></i>
                            </td>
                            <td><strong>@item.Names.OrderByDescending(n => n.Date).FirstOrDefault()?.Name</strong></td>
                        </tr>

                        <!-- Rozwijany wiersz ze szczegółami -->
                        @if (isExpanded)
                        {
                            <tr class="table-light">
                                <td></td>
                                <td colspan="3" class="p-4">
                                    <div class="card border-primary shadow-sm bg-white">
                                        <div class="card-body">
                                            <RadonInstitutionDetailsView Institution="item" />
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINACJA -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            <span>Strona @_filterModel.Page z @TotalPages (Łącznie rekordów: @_response.Pagination.TotalCount)</span>
        </div>

        <!-- NUMERY STRON -->
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <!-- Przycisk Poprzednia -->
                <li class="page-item @(_filterModel.Page <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(_filterModel.Page - 1)">Poprzednia</button>
                </li>

                <!-- Pętla po numerach stron -->
                @foreach (var pageNum in GetVisiblePages())
                {
                    @if (pageNum == -1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    else
                    {
                        <li class="page-item @(pageNum == _filterModel.Page ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                        </li>
                    }
                }

                <!-- Przycisk Następna -->
                <li class="page-item @(_filterModel.Page >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(_filterModel.Page + 1)">Następna</button>
                </li>
            </ul>
        </nav>
    </div>
}

@code {
    private RadonInstitutionFilterViewModel _filterModel = new();
    private Response<Institution>? _response;

    private List<DictionaryItem>? _kinds;
    private List<DictionaryItem>? _statuses;
    private List<DictionaryItem>? _universityTypes;
    private List<DictionaryItem>? _scientificInstitutionTypes;
    private string? _errorMessage;

    // Stan rozwijanego wiersza (przechowuje UUID aktualnie rozwiniętej instytucji)
    private Guid? _expandedUuid;

    private int TotalPages => _response == null ? 1 : (int)Math.Ceiling((double)_response.Pagination.TotalCount / _filterModel.ItemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await LoadDictionariesAsync();
        await LoadDataAsync();
    }

    private void ToggleRow(Guid uuid)
    {
        if (_expandedUuid == uuid)
        {
            _expandedUuid = null; // Zwiń, jeśli kliknięto ponownie ten sam
        }
        else
        {
            _expandedUuid = uuid; // Rozwiń nowy wiersz
        }
    }

    private async Task LoadDictionariesAsync()
    {
        using var client = await ClientFactory.CreateUnAuthorizedClientAsync();
        try
        {
            _kinds = await client.GetFromJsonAsync<List<DictionaryItem>>("/api/radon/institutions/kinds");
            _statuses = await client.GetFromJsonAsync<List<DictionaryItem>>("/api/radon/institutions/statuses");
            _universityTypes = await client.GetFromJsonAsync<List<DictionaryItem>>("/api/radon/institutions/universityTypes");
            _scientificInstitutionTypes = await client.GetFromJsonAsync<List<DictionaryItem>>("/api/radon/institutions/scientificInstitutionTypes");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd podczas ładowania słowników: {ex.Message}";
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _errorMessage = null;
            _expandedUuid = null;

            QueryParameters queryParameters = _filterModel.ToQueryParameters();

            _response = await InstitutionService.GetAsync(queryParameters);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd podczas pobierania danych: {ex.Message}";
        }
    }

    private async Task ChangePage(int newPage)
    {
        _filterModel.Page = newPage;
        await LoadDataAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _filterModel = new RadonInstitutionFilterViewModel();
        await LoadDataAsync();
    }

    private IEnumerable<int> GetVisiblePages()
    {
        var total = TotalPages;
        var current = _filterModel.Page;
        var delta = 2;
        var range = new List<int>();

        for (int i = 1; i <= total; i++)
        {
            if (i == 1 || i == total || (i >= current - delta && i <= current + delta))
            {
                range.Add(i);
            }
        }

        var result = new List<int>();
        int? last = null;

        foreach (var i in range)
        {
            if (last.HasValue)
            {
                if (i - last == 2)
                {
                    result.Add(last.Value + 1);
                }
                else if (i - last > 2)
                {
                    result.Add(-1);
                }
            }
            result.Add(i);
            last = i;
        }

        return result;
    }
}