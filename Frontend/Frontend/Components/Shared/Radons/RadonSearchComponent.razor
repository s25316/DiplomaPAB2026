@using Diploma.Models.PersonEducations
@using RADON.Models.Courses.Responses
@using RADON.Models.Institutions.Responses
@inject IBackendHttpClientFactory ClientFactory

<div class="container my-4">
    <h2>Kreator wykształcenia z bazy RADON</h2>
    <hr />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    <!-- KROK 1: Wybór instytucji -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <strong>Krok 1: Wybierz instytucję</strong>
        </div>
        <div class="card-body">
            @if (_selectedInstitution == null)
            {
                <RadonInstitutionsComponent OnInstitutionSelected="HandleInstitutionSelected" />
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded">
                    <div>
                        <h5 class="mb-1 text-primary">@_selectedInstitution?.Names.OrderByDescending(i => i.Date).FirstOrDefault()?.Name</h5>
                        <p class="mb-0 text-muted small">ID / UUID: @_selectedInstitution.InstitutionUuid</p>
                    </div>
                    <button class="btn btn-outline-danger btn-sm" @onclick="ResetInstitution">Zmień instytucję</button>
                </div>
            }
        </div>
    </div>

    <!-- KROK 2: Wybór kierunku i instancji -->
    @if (_selectedInstitution != null)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-success text-white">
                <strong>Krok 2: Wybierz kierunek oraz instancję</strong>
            </div>
            <div class="card-body">
                <RadonCoursesComponent InstitutionId="_selectedInstitution.InstitutionUuid"
                                       OnCourseSelected="HandleCourseSelected"
                                       OnInstanceSelected="HandleInstanceSelected" />
            </div>
        </div>
    }

    <!-- KROK 3: Formularz Semestrów i Roków (używamy lokalnego modelu z 'set') -->
    @if (_selectedCourse != null)
    {
        <div class="card border-success shadow mb-4">
            <div class="card-header bg-success text-white">
                <strong>Krok 3: Okres trwania i zapis</strong>
            </div>
            <div class="card-body">
                <EditForm Model="_formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <h6 class="text-primary font-weight-bold">Dane początkowe (Start)</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Rok startu</label>
                            <InputNumber class="form-control" @bind-Value="_formModel.StartYear" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Semestr startu</label>
                            <InputSelect class="form-select" @bind-Value="_formModel.StartSemestrId">
                                <option value="0">-- Wybierz semestr --</option>
                                @if (_semesters != null)
                                {
                                    @foreach (var sem in _semesters)
                                    {
                                        <option value="@sem.Code">@sem.Name</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="hasEndCheck" @onchange="ToggleEndSection" checked="@(_includeEnd)">
                        <label class="form-check-label font-weight-bold" for="hasEndCheck">
                            Określ datę zakończenia (opcjonalnie)
                        </label>
                    </div>

                    @if (_includeEnd)
                    {
                        <h6 class="text-secondary font-weight-bold">Dane końcowe (End)</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Rok końca</label>
                                <InputNumber class="form-control" @bind-Value="_formModel.EndYear" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Semestr końca</label>
                                <InputSelect class="form-select" @bind-Value="_formModel.EndSemestrId">
                                    <option value="0">-- Wybierz semestr --</option>
                                    @if (_semesters != null)
                                    {
                                        @foreach (var sem in _semesters)
                                        {
                                            <option value="@sem.Code">@sem.Name</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    }

                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-success btn-lg">Zapisz wykształcenie w profilu</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnEducationCreated { get; set; }

    private Institution? _selectedInstitution;
    private Course? _selectedCourse;
    private CourseInstance? _selectedInstance;
    private List<Diploma.Models.Dictionaries.DictionaryItem<int>>? _semesters;
    private bool _includeEnd = false;
    private string? _errorMessage;

    private PersonEducationFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSemestersAsync();
    }

    private async Task LoadSemestersAsync()
    {
        try
        {
            var client = await ClientFactory.CreateUnAuthorizedClientAsync();
            _semesters = await client.GetFromJsonAsync<List<Diploma.Models.Dictionaries.DictionaryItem<int>>>("api/person/profile/educations/semesters");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd ładowania słownika semestrów: {ex.Message}";
        }
    }

    private void HandleInstitutionSelected(Institution institution)
    {
        _selectedInstitution = institution;
        _selectedCourse = null;
        _selectedInstance = null;
        _formModel.EducationCourseId = Guid.Empty;
        _formModel.EducationCourseInstanceId = null;
    }

    private void ResetInstitution()
    {
        _selectedInstitution = null;
        _selectedCourse = null;
        _selectedInstance = null;
    }

    private void HandleCourseSelected(Course? course)
    {
        _selectedCourse = course;
        if (course != null)
        {
            _formModel.EducationCourseId = course.CourseUuid;
        }
    }

    private void HandleInstanceSelected(CourseInstance instance)
    {
        _selectedInstance = instance;
        _formModel.EducationCourseInstanceId = instance?.CourseInstanceUuid;
    }

    private void ToggleEndSection(ChangeEventArgs e)
    {
        _includeEnd = (bool)(e.Value ?? false);
        if (!_includeEnd)
        {
            _formModel.EndYear = null;
            _formModel.EndSemestrId = null;
        }
        else
        {
            _formModel.EndYear = 0;
            _formModel.EndSemestrId = 0;
        }
    }

    private async Task HandleSubmit()
    {
        // Tworzymy oryginalny kontrakt z 'init' do wysyłki do API
        var apiRequest = new PersonEducationCreateRequest
        {
            EducationCourseId = _formModel.EducationCourseId,
            EducationCourseInstanceId = _formModel.EducationCourseInstanceId,
            Start = new EducationSemestrRequestDto
            {
                Year = _formModel.StartYear,
                SemestrId = _formModel.StartSemestrId
            },
            End = _includeEnd && _formModel.EndYear.HasValue && _formModel.EndSemestrId.HasValue
                ? new EducationSemestrRequestDto
                {
                    Year = _formModel.EndYear.Value,
                    SemestrId = _formModel.EndSemestrId.Value
                }
                : null
        };

        try
        {
            var client = await ClientFactory.CreateAuthorizedClientAsync();
            if (client is null)
                return;

            var response = await client.PostAsJsonAsync("api/person/profile/educations", apiRequest);
            if (response.IsSuccessStatusCode)
            {
                // Powiadamiamy komponent nadrzędny o sukcesie
                await OnEducationCreated.InvokeAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _errorMessage = "Zbyt dużo rekordów.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                _errorMessage = "Sprawdź poprawność dat w ramach wybranego kierunku lub instancji.";
            }
            else
            {
                _errorMessage = "Błąd podczas zapisu w API.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd sieci: {ex.Message}";
        }
    }
}